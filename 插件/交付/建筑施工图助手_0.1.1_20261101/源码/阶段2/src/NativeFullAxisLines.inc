// The reference axis stroke is itself an AcDbLine. TCH circles remain separate.
std::wstring symbolName(AcDbObjectId id){
 auto record=open<AcDbSymbolTableRecord>(id);AcString name;status(record->getName(name),"axis style symbol name");return name.kACharPtr();
}
FullAxisStyle fullAxisStyle(AcDbObjectId id){
 auto e=open<AcDbLine>(id);require(e->isA()==AcDbLine::desc(),"full axis source is not exact AcDbLine");
 FullAxisStyle s;s.layer=symbolName(e->layerId());s.linetype=symbolName(e->linetypeId());s.colour=e->colorIndex();s.weight=e->lineWeight();s.scale=e->linetypeScale();s.thickness=e->thickness();s.normal=e->normal();
 auto layer=open<AcDbLayerTableRecord>(e->layerId());s.layerColour=layer->color().colorIndex();s.layerWeight=layer->lineWeight();s.layerLinetype=symbolName(layer->linetypeObjectId());s.layerOff=layer->isOff();s.layerFrozen=layer->isFrozen();s.layerPlottable=layer->isPlottable();
 auto line=open<AcDbLinetypeTableRecord>(e->linetypeId());s.pattern=line->patternLength();
 // A simple dash/dot has no text style. textAt is not applicable to that slot.
 for(int i=0;i<line->numDashes();++i){require(line->shapeNumberAt(i)==0&&line->shapeStyleAt(i).isNull(),"complex axis pattern needs explicit support");s.dashes.push_back(line->dashLengthAt(i));}
 require(std::isfinite(s.scale)&&s.scale>0&&std::isfinite(s.pattern)&&s.pattern>0&&!s.dashes.empty(),"axis linetype pattern is empty or invalid");return s;
}
void sameFullAxisStyle(const FullAxisStyle& a,const FullAxisStyle& b){
 require(a.layer==b.layer&&a.linetype==b.linetype&&a.layerLinetype==b.layerLinetype&&a.colour==b.colour&&a.layerColour==b.layerColour&&a.weight==b.weight&&a.layerWeight==b.layerWeight&&a.layerOff==b.layerOff&&a.layerFrozen==b.layerFrozen&&a.layerPlottable==b.layerPlottable,"axis reference style/layer conflict");
 require(std::abs(a.scale-b.scale)<1e-9&&std::abs(a.pattern-b.pattern)<1e-9&&std::abs(a.thickness-b.thickness)<1e-9&&(a.normal-b.normal).length()<1e-9&&a.dashes.size()==b.dashes.size(),"axis reference pattern or scale conflict");
 for(std::size_t i=0;i<a.dashes.size();++i)require(std::isfinite(a.dashes[i])&&std::abs(a.dashes[i]-b.dashes[i])<1e-9,"axis reference dash definition conflict");
}

std::size_t fullAxisRootCount(const DrawnAnnotations& drawn){std::size_t n=0;for(const auto& a:drawn.fullAxisLines)n+=a.pieces.size();return n;}
void captureAxisText(AcDbDatabase& target,DrawnAnnotations& drawn){
 auto model=open<AcDbBlockTableRecord>(modelId(target));AcDbBlockTableRecordIterator* raw{};status(model->newIterator(raw),"axis text source iterator");std::unique_ptr<AcDbBlockTableRecordIterator> it(raw);
 for(;!it->done();it->step()){AcDbObjectId id;status(it->getEntityId(id),"axis text source id");auto e=open<AcDbEntity>(id);const std::wstring type=e->isA()->name();if((type!=L"TDbText"&&type!=L"TDbSymbElevation")||e->visibility()!=AcDb::kVisible)continue;auto layer=open<AcDbLayerTableRecord>(e->layerId());if(layer->isOff()||layer->isFrozen())continue;AcDbExtents box;status(e->getGeomExtents(box),"actual axis text/symbol box");const auto a=box.minPoint(),b=box.maxPoint();require(a.x<b.x&&a.y<b.y,"empty axis text box needs review");drawn.axisTextBoxes.push_back({a.x,a.y,b.x,b.y});drawn.axisTextSources.push_back(id);}
}
void axesToBack(AcDbDatabase& db,DrawnAnnotations& drawn){
 auto model=editObject<AcDbBlockTableRecord>(modelId(db));AcDbSortentsTable* raw{};status(model->getSortentsTable(raw,AcDb::kForWrite,true),"axis draw order table");std::unique_ptr<AcDbSortentsTable,Close<AcDbSortentsTable>> table(raw);AcDbObjectIdArray before,axes;status(table->getFullDrawOrder(before),"source relative draw order");for(const auto& a:drawn.fullAxisLines)for(const auto& piece:a.pieces)axes.append(piece.id);for(int i=0;i<before.length();++i)if(!axes.contains(before[i]))drawn.protectedDrawOrder.push_back(before[i].handle());require(table->blockId()==modelId(db),"axis sortents table bound to wrong block");std::set<AcDbObjectId> unique;for(int i=0;i<axes.length();++i){require(unique.insert(axes[i]).second,"duplicate axis before sortents");auto e=open<AcDbEntity>(axes[i]);require(e->ownerId()==modelId(db),"axis sortents input outside model");}// Sortents opens its block internally; release our write-open block first.
 model.reset();const auto moved=table->moveToBottom(axes);require(moved==Acad::eOk,(std::string("place axes behind architecture status=")+std::to_string(static_cast<int>(moved))).c_str());
}
void drawFullAxisLines(AcDbDatabase& reference,AcDbDatabase& target,const bcp::Result& result,DrawnAnnotations& drawn,double xmin,double ymin,double xmax,double ymax){
 const auto prototype=find(reference,"17E4");const auto source=fullAxisStyle(prototype);require(source.layer==L"A-DOTE"&&source.linetype==L"DOTE"&&source.layerLinetype==L"DOTE"&&source.colour==256&&source.layerColour==1&&!source.layerOff&&!source.layerFrozen&&source.layerPlottable,"reference axis prototype differs");
 require(reference.ltscale()>0&&target.ltscale()>0,"invalid global axis scale");auto expected=source;expected.scale=source.scale*reference.ltscale()/target.ltscale();if(drawn.axisPresentation)captureAxisText(target,drawn);
 for(const auto& axis:result.axes){if(!axis.confirmed||axis.confirmedLabel.empty())continue;const auto end=std::find_if(drawn.axes.begin(),drawn.axes.end(),[&](const DrawnAxis& a){return a.vertical==axis.vertical&&a.label==axis.confirmedLabel;});const bool negative=end!=drawn.axes.end()&&end->negative,positive=end!=drawn.axes.end()&&end->positive;const auto span=drawn.wallFollowingAxes?bcp::axisWallDisplaySpan(axis.negativeReach,axis.positiveReach,axis.vertical?ymin:xmin,axis.vertical?ymax:xmax,negative,positive,1000):std::make_pair((axis.vertical?ymin:xmin)-(negative?1000:0),(axis.vertical?ymax:xmax)+(positive?1000:0));const double low=span.first,high=span.second;const auto at=[&](double v){return axis.vertical?AcGePoint3d(axis.coordinate,v,0):AcGePoint3d(v,axis.coordinate,0);};
  FullAxisLine line{AcDbObjectId(),axis.vertical,axis.coordinate,axis.confirmedLabel,at(low),at(high),expected,reference.ltscale(),target.ltscale()};const auto supported=drawn.breakUnsupportedSpans?bcp::axisSupportedDisplayIntervals(axis.supportRanges,axis.vertical?ymin:xmin,axis.vertical?ymax:xmax,negative,positive,1000):std::vector<std::pair<double,double>>{{low,high}};std::vector<std::pair<double,double>> intervals;for(const auto& s:supported){const auto visible=drawn.axisPresentation?bcp::axisDisplayIntervals(axis.vertical,axis.coordinate,s.first,s.second,drawn.axisTextBoxes,80):std::vector<std::pair<double,double>>{s};intervals.insert(intervals.end(),visible.begin(),visible.end());}require(!intervals.empty(),"annotation masks cover whole logical axis; manual confirmation required");
  for(const auto& interval:intervals){const auto id=cloneOne(reference,prototype,target);{auto e=editObject<AcDbLine>(id);status(e->setStartPoint(at(interval.first)),"axis visible interval start");status(e->setEndPoint(at(interval.second)),"axis visible interval end");status(e->setLinetypeScale(expected.scale),"reference effective scale");}sameFullAxisStyle(expected,fullAxisStyle(id));line.pieces.push_back({id,at(interval.first),at(interval.second)});}
  line.id=line.pieces.front().id;if(drawn.axisPresentation){const std::wstring name=L"BCP_GRID_"+std::wstring(axis.vertical?L"V_":L"H_")+std::wstring(axis.confirmedLabel.begin(),axis.confirmedLabel.end());auto dictionary=editObject<AcDbDictionary>(target.groupDictionaryId());auto group=std::make_unique<AcDbGroup>(name.c_str(),true);status(dictionary->setAt(name.c_str(),group.get(),line.group),"logical axis group");std::unique_ptr<AcDbGroup,Close<AcDbGroup>> managed(group.release());for(const auto& piece:line.pieces)status(managed->append(piece.id),"axis group visible member");}drawn.fullAxisLines.push_back(std::move(line));
 }
 if(drawn.axisPresentation)axesToBack(target,drawn);
}
void verifyFullAxisLines(AcDbDatabase& db,const DrawnAnnotations& drawn){
 std::set<AcDbObjectId> all;for(const auto& axis:drawn.fullAxisLines){AcDbObjectIdArray members;if(!axis.group.isNull()){AcDbObjectId gid;status(db.getAcDbObjectId(gid,false,axis.group.handle()),"saved logical group");auto group=open<AcDbGroup>(gid);require(group->isSelectable()&&group->allEntityIds(members)==axis.pieces.size(),"saved axis group member count");}
  for(const auto& piece:axis.pieces){AcDbObjectId id;status(db.getAcDbObjectId(id,false,piece.id.handle()),"saved axis piece");require(all.insert(id).second,"duplicate axis display entity");sameFullAxisStyle(axis.style,fullAxisStyle(id));auto e=open<AcDbLine>(id);require(e->ownerId()==modelId(db)&&e->visibility()==AcDb::kVisible&&(e->startPoint()-piece.a).length()<1e-6&&(e->endPoint()-piece.b).length()<1e-6&&std::abs(db.ltscale()-axis.targetGlobalScale)<1e-9,"saved axis display interval differs");if(!axis.group.isNull())require(members.contains(id),"axis piece not in saved group");}}
 if(drawn.axisPresentation){auto model=open<AcDbBlockTableRecord>(modelId(db));AcDbSortentsTable* raw{};status(model->getSortentsTable(raw,AcDb::kForRead,false),"saved draw order table");std::unique_ptr<AcDbSortentsTable,Close<AcDbSortentsTable>> table(raw);AcDbObjectIdArray order;status(table->getFullDrawOrder(order),"saved effective draw order");std::set<AcDbHandle> underlays;if(drawn.anchoredDirect){for(const auto& m:drawn.witnessMasks)underlays.insert(m.id.handle());for(const auto& d:drawn.dimensions)if(d.row=="opening-wall-chain"||d.row=="opening-end-face"||(drawn.allDirectDimensions&&d.row!="internal-opening-chain"))underlays.insert(d.id.handle());}AcDbObjectIdArray filtered;for(int i=0;i<order.length();++i)if(!underlays.count(order[i].handle()))filtered.append(order[i]);order=filtered;for(std::size_t i=0;i<all.size();++i)require(all.count(order[static_cast<int>(i)])==1,"axis stroke not below architecture");std::vector<AcDbHandle> remaining;for(int i=0;i<order.length();++i)if(!all.count(order[i]))remaining.push_back(order[i].handle());require(remaining.size()>=drawn.protectedDrawOrder.size(),"draw order lost architectural roots");for(std::size_t i=0;i<drawn.protectedDrawOrder.size();++i)require(remaining[i]==drawn.protectedDrawOrder[i],"original relative draw order changed");}
}
std::string axisHandle(AcDbObjectId id){wchar_t h[32]{};id.handle().getIntoAsciiBuffer(h);const std::wstring text=h;return std::string(text.begin(),text.end());}
std::string fullAxisLinesJson(const DrawnAnnotations& drawn){
 std::ostringstream out;out<<std::setprecision(17)<<'[';for(std::size_t i=0;i<drawn.fullAxisLines.size();++i){if(i)out<<',';const auto& a=drawn.fullAxisLines[i];const auto& s=a.style;out<<"{\"handle\":\""<<axisHandle(a.id)<<"\",\"group\":\""<<axisHandle(a.group)<<"\",\"label\":\""<<a.label<<"\",\"vertical\":"<<(a.vertical?"true":"false")<<",\"station\":"<<a.coordinate<<",\"start\":["<<a.a.x<<','<<a.a.y<<','<<a.a.z<<"],\"end\":["<<a.b.x<<','<<a.b.y<<','<<a.b.z<<"],\"nativeType\":\"AcDbLine\",\"layer\":\"A-DOTE\",\"linetype\":\"DOTE\",\"referenceHandle\":\"17E4\",\"entityColour\":"<<s.colour<<",\"layerColour\":"<<s.layerColour<<",\"entityLineWeight\":"<<s.weight<<",\"layerLineWeight\":"<<s.layerWeight<<",\"linetypeScale\":"<<s.scale<<",\"referenceGlobalScale\":"<<a.referenceGlobalScale<<",\"targetGlobalScale\":"<<a.targetGlobalScale<<",\"patternLength\":"<<s.pattern<<",\"dashes\":[";for(std::size_t j=0;j<s.dashes.size();++j){if(j)out<<',';out<<s.dashes[j];}out<<"],\"pieces\":[";for(std::size_t j=0;j<a.pieces.size();++j){if(j)out<<',';const auto& p=a.pieces[j];out<<"{\"handle\":\""<<axisHandle(p.id)<<"\",\"start\":["<<p.a.x<<','<<p.a.y<<','<<p.a.z<<"],\"end\":["<<p.b.x<<','<<p.b.y<<','<<p.b.z<<"]}";}out<<"]}";}out<<']';return out.str();
}
std::string axisPresentationJson(const DrawnAnnotations& drawn){std::ostringstream out;out<<std::setprecision(17)<<"{\"gapMode\":\""<<(drawn.breakUnsupportedSpans?"break-unsupported-wall-gaps":"bridge-associated-wall-ends")<<"\",\"spanMode\":\""<<(drawn.wallFollowingAxes?"associated-wall-ends":"body-envelope")<<"\",\"enabled\":"<<(drawn.axisPresentation?"true":"false")<<",\"clearanceModelMm\":80,\"axisPieceCount\":"<<fullAxisRootCount(drawn)<<",\"axisGroups\":"<<(drawn.axisPresentation?drawn.fullAxisLines.size():0)<<",\"belowArchitectureVerifiedOnReopen\":"<<(drawn.axisPresentation?"true":"false")<<",\"obstacles\":[";for(std::size_t i=0;i<drawn.axisTextBoxes.size();++i){if(i)out<<',';const auto& b=drawn.axisTextBoxes[i];out<<"{\"handle\":\""<<axisHandle(drawn.axisTextSources[i])<<"\",\"min\":["<<b.xmin<<','<<b.ymin<<"],\"max\":["<<b.xmax<<','<<b.ymax<<"]}";}out<<"]}";return out.str();}
