// Layer names and colour overrides are bound to the user's table extraction.
void applyUnifiedLayers(AcDbDatabase& db,DrawnAnnotations& drawn,const std::wstring& config){
 const fs::path path=ini(config,L"layerStandard");require(sha(path)==ascii(ini(config,L"layerStandardHash")),"layer standard source changed");AcDbDatabase standard(false,true);status(standard.readDwgFile(path.c_str(),AcDbDatabase::kForReadAndAllShare,false),"read standard for layer resources");status(standard.closeInput(true),"finish layer resource read");
 const std::map<std::wstring,std::wstring> aliases{{L"WALL",L"A-WALL"},{L"CURTWALL",L"A-CURTWALL"},{L"WINDOW",L"A-WINDOW"},{L"AXIS",L"A-AXIS"},{L"AXIS_TEXT",L"A-AXIS-TEXT"},{L"PUB_DIM",L"A-PUB_DIM"},{L"PUB_TEXT",L"A-房间名称"},{L"DIM_ELEV",L"A-DIM_ELEV"},{L"DIM_SYMB",L"A-DIM_SYMB"},{L"STAIR",L"A-STAIR"},{L"AE-FURN-MOVE",L"A-家具"},{L"A-PUB_TAB",L"A-表格"}};
 for(const auto& pair:aliases){auto table=open<AcDbLayerTable>(db.layerTableId());AcDbObjectId old,dest;if(table->getAt(pair.first.c_str(),old)!=Acad::eOk)continue;if(table->getAt(pair.second.c_str(),dest)==Acad::eOk&&dest!=old){auto e=editObject<AcDbLayerTableRecord>(dest);status(e->setName((L"BCP_UNUSED_"+std::to_wstring(static_cast<unsigned long long>(dest.asOldId()))).c_str()),"retain colliding prior layer");}table.reset();auto e=editObject<AcDbLayerTableRecord>(old);status(e->setName(pair.second.c_str()),"rename semantic layer");}
 AcDbObjectIdArray layers;{auto table=open<AcDbLayerTable>(standard.layerTableId());AcDbLayerTableIterator* raw{};status(table->newIterator(raw),"standard resource iterator");std::unique_ptr<AcDbLayerTableIterator> it(raw);for(;!it->done();it->step()){AcDbObjectId id;status(it->getRecordId(id),"standard resource id");const auto name=symbolName(id);if(name!=L"0"&&name!=L"Defpoints")layers.append(id);}}
 AcDbIdMapping mapping;status(standard.wblockCloneObjects(layers,db.layerTableId(),mapping,AcDb::kDrcIgnore,false),"import standard layer definitions");
 for(int i=0;i<layers.length();++i){auto src=open<AcDbLayerTableRecord>(layers[i]);AcString name;status(src->getName(name),"standard resource name");AcDbObjectId id;{auto table=open<AcDbLayerTable>(db.layerTableId());status(table->getAt(name.kACharPtr(),id),"target standard layer");}auto dst=editObject<AcDbLayerTableRecord>(id);dst->setColor(src->color());require(dst->color()==src->color(),"standard layer colour");status(dst->setLineWeight(src->lineWeight()),"standard layer lineweight");AcDbObjectId lt;{auto table=open<AcDbLinetypeTable>(db.linetypeTableId());status(table->getAt(symbolName(src->linetypeObjectId()).c_str(),lt),"standard linetype target");}status(dst->setLinetypeObjectId(lt),"standard layer linetype");status(dst->setIsPlottable(src->isPlottable()),"standard plottability");}
 const auto ensure=[&](const wchar_t* name,int colour){AcDbObjectId id;{auto table=open<AcDbLayerTable>(db.layerTableId());if(table->getAt(name,id)!=Acad::eOk){table.reset();auto edit=editObject<AcDbLayerTable>(db.layerTableId());auto layer=std::make_unique<AcDbLayerTableRecord>();status(layer->setName(name),"new standard alias");status(edit->add(id,layer.get()),"add standard alias");layer.release()->close();}}auto e=editObject<AcDbLayerTableRecord>(id);AcCmColor c;c.setColorIndex(colour);e->setColor(c);require(e->color().colorIndex()==colour,"table colour override");return id;};ensure(L"A-WINDOW-TEXT",7);ensure(L"A-AXIS-TEXT",7);ensure(L"A-家具",254);ensure(L"A-表格",254);ensure(L"A-PUB-HATCH",251);
 std::set<AcDbObjectId> captionIds;for(const auto& c:drawn.captions)captionIds.insert(c.id);std::map<AcDbObjectId,std::wstring> dimensionLayers;for(const auto& d:drawn.dimensions){const std::wstring layer=d.row=="axis"||d.row=="total-body-envelope"?L"A-AXIS":L"A-PUB_DIM";dimensionLayers[d.id]=layer;if(!d.container.isNull())dimensionLayers[d.container]=layer;}
 for(const auto& a:drawn.apronStrokes)dimensionLayers[a.id]=L"A-GROUND";for(const auto id:drawn.apronTexts)dimensionLayers[id]=L"A-PUB_TEXT";
 for(const auto& m:drawn.witnessMasks)dimensionLayers[m.id]=L"A-PUB_DIM";
 std::vector<AcDbObjectId> ids;{auto table=open<AcDbBlockTable>(db.blockTableId());AcDbBlockTableIterator* raw{};status(table->newIterator(raw),"unified block iterator");std::unique_ptr<AcDbBlockTableIterator> it(raw);for(;!it->done();it->step()){AcDbObjectId bid;status(it->getRecordId(bid),"unified block id");auto b=open<AcDbBlockTableRecord>(bid);if(b->isFromExternalReference())continue;AcDbBlockTableRecordIterator* er{};status(b->newIterator(er),"unified entity iterator");std::unique_ptr<AcDbBlockTableRecordIterator> eit(er);for(;!eit->done();eit->step()){AcDbObjectId id;status(eit->getEntityId(id),"unified entity id");ids.push_back(id);}}}
 std::map<std::wstring,int> counts;for(const auto id:ids){auto e=editObject<AcDbEntity>(id);auto name=symbolName(e->layerId());const bool model=e->ownerId()==modelId(db);if(model&&name==L"辅助线"){status(e->setVisibility(AcDb::kInvisible),"retain nonplot helper effect after remapping");drawn.hiddenHelpers.push_back(id);}if(dimensionLayers.count(id))name=dimensionLayers.at(id);else if(captionIds.count(id))name=L"A-WINDOW-TEXT";else if(model){const std::wstring type=e->isA()->name();if(name==L"A-家具"){if(auto* ref=AcDbBlockReference::cast(e.get())){AcDbDynBlockReference dynamic(ref);const auto bid=dynamic.isDynamicBlock()?dynamic.dynamicBlockTableRecord():ref->blockTableRecord();const auto family=symbolName(bid);if(family.find(L"厨房")!=std::wstring::npos||family.find(L"卫生间")!=std::wstring::npos||family.find(L"洁具")!=std::wstring::npos)name=L"A-洁具、厨具";}}if(type==L"TDbWall"&&name!=L"A-CURTWALL"){AcDbExtents box;status(e->getGeomExtents(box),"wall layer width");const auto size=box.maxPoint()-box.minPoint();name=std::abs(std::min(size.x,size.y)-100)<1e-5?L"A-轻质隔墙":L"A-WALL";}else if(name==L"0"||name==L"辅助线")name=L"A-立面看线";else if(name==L"图框开放字"||name==L"图框固定块")name=L"A-PUB_TEXT";else if(name.rfind(L"A-",0)!=0)name=L"A-立面看线";}else if(!dimensionLayers.count(id)&&std::wstring(e->isA()->name()).rfind(L"TDb",0)!=0){name=L"0";status(e->setColorIndex(0),"block child ByBlock colour");}
  if(symbolName(e->layerId())!=name)status(e->setLayer(name.c_str()),"assign standard entity layer");if((model||dimensionLayers.count(id))&&e->colorIndex()!=256)status(e->setColorIndex(256),"standard ByLayer entity colour");if(e->lineWeight()!=AcDb::kLnWtByLayer){const auto changed=e->setLineWeight(AcDb::kLnWtByLayer);require(changed==Acad::eOk,(std::string("standard lineweight id=")+axisHandle(id)+" type="+std::string(e->isA()->name(),e->isA()->name()+wcslen(e->isA()->name()))+" status="+std::to_string(changed)).c_str());}if(model)++counts[name];if(model||dimensionLayers.count(id))drawn.entityLayers.emplace(id.handle(),name);}
 for(const auto id:drawn.legacyFrameLayers){auto e=editObject<AcDbLayerTableRecord>(id);e->setIsOff(true);}for(auto& axis:drawn.fullAxisLines)axis.style=fullAxisStyle(axis.id);
 std::ostringstream out;out<<"{\"standardSHA256\":\""<<sha(path)<<"\",\"layers\":[";bool first=true;for(const auto& c:counts){AcDbObjectId id;{auto table=open<AcDbLayerTable>(db.layerTableId());status(table->getAt(c.first.c_str(),id),"audit standard layer");}auto e=open<AcDbLayerTableRecord>(id);drawn.layerStates.push_back({id.handle(),c.first,symbolName(e->linetypeObjectId()),e->color().colorIndex(),static_cast<int>(e->lineWeight())});if(!first)out<<',';first=false;out<<"{\"name\":"<<jsonUtf8(c.first)<<",\"roots\":"<<c.second<<",\"colour\":"<<e->color().colorIndex()<<",\"lineWeight\":"<<static_cast<int>(e->lineWeight())<<",\"linetype\":"<<jsonUtf8(symbolName(e->linetypeObjectId()))<<'}';}out<<"],\"tableOverrides\":[\"A-家具254\",\"A-表格254\",\"A-WINDOW-TEXT\",\"A-PUB-HATCH251\"]}";drawn.layerAudit=out.str();require(sha(path)==ascii(ini(config,L"layerStandardHash")),"standard file modified");
}
void verifyUnified(AcDbDatabase& db,const DrawnAnnotations& drawn){for(const auto old:drawn.hiddenHelpers){AcDbObjectId id;status(db.getAcDbObjectId(id,false,old.handle()),"saved nonplot helper");auto e=open<AcDbEntity>(id);require(e->visibility()==AcDb::kInvisible,"nonplot helper became printable");}for(const auto& s:drawn.layerStates){AcDbObjectId id;status(db.getAcDbObjectId(id,false,s.id),"saved unified layer");auto e=open<AcDbLayerTableRecord>(id);require(symbolName(id)==s.name&&e->color().colorIndex()==s.colour&&static_cast<int>(e->lineWeight())==s.weight&&symbolName(e->linetypeObjectId())==s.linetype,"saved standard layer properties differ");}for(const auto& pair:drawn.entityLayers){AcDbObjectId id;status(db.getAcDbObjectId(id,false,pair.first),"saved layer membership");auto e=open<AcDbEntity>(id);require(symbolName(e->layerId())==pair.second,"saved entity layer differs");}for(const auto& c:drawn.captions){AcDbObjectId id;status(db.getAcDbObjectId(id,false,c.id.handle()),"saved opening caption");auto e=open<AcDbText>(id);AcString text;status(e->textString(text),"saved caption content");require(std::wstring(text.kACharPtr())==c.number&&std::abs(e->rotation()-c.rotation)<1e-6&&(e->alignmentPoint()-c.position).length()<1e-6&&symbolName(e->layerId())==L"A-WINDOW-TEXT","saved caption differs");}for(const auto& d:drawn.dimensions){AcDbObjectId id;status(db.getAcDbObjectId(id,false,d.id.handle()),"saved detailed dimension");auto e=open<AcDbEntity>(id);AcGePoint3dArray points;AcDbIntArray modes,geo;status(e->getGripPoints(points,modes,geo),"saved detailed points");require(points.length()==8&&(points[2]-d.measuredA).length()<1e-6&&(points[3]-d.measuredB).length()<1e-6,"saved detailed measurement points changed");}}
