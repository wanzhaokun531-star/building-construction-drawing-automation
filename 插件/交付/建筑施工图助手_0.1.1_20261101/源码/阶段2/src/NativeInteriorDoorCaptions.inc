void doorStrokes(const AcDbEntity& entity,std::vector<bcpdoor::Stroke>& result,int depth=0){
 require(depth<6,"door stroke nesting limit");bcpdoor::Stroke s;
 if(const auto* l=AcDbLine::cast(&entity)){s.x1=l->startPoint().x;s.y1=l->startPoint().y;s.x2=l->endPoint().x;s.y2=l->endPoint().y;result.push_back(s);return;}
 if(const auto* a=AcDbArc::cast(&entity)){require(std::abs(std::abs(a->normal().z)-1)<1e-6,"door arc is not in plan plane");AcGePoint3d start;status(a->getStartPoint(start),"door arc start");s.arc=true;s.cx=a->center().x;s.cy=a->center().y;s.radius=a->radius();s.angle=std::atan2(start.y-s.cy,start.x-s.cx);s.sweep=bcpdoor::angleDelta(a->endAngle()-a->startAngle())*(a->normal().z>0?1:-1);result.push_back(s);return;}
 TemplateParts parts(&entity);status(entity.explode(parts.values),"read actual door linework");require(parts.values.length()>0,"door has no readable plan ink");std::set<const void*> seen;for(int i=0;i<parts.values.length();++i){auto* e=AcDbEntity::cast(static_cast<AcRxObject*>(parts.values[i]));require(e&&e!=&entity&&e->database()==nullptr&&e->objectId().isNull()&&seen.insert(e).second,"door stroke ownership");doorStrokes(*e,result,depth+1);}
}
#include "NativeDoorCaptionFurniture.inc"
std::string interiorDoorCaptions(AcDbDatabase& db,std::vector<DoorCaptionTarget>& all,const std::wstring& config){
 const fs::path contract=ini(config,L"interiorDoorContract");require(sha(contract)==ascii(ini(config,L"interiorDoorContractHash")),"interior door contract changed");std::ifstream in(contract);std::string tag,text,opening,wall;int count{};require(static_cast<bool>(in>>tag>>count)&&tag=="DOORLOWER1"&&count>0&&count<=14,"interior door header");std::map<std::string,std::string> scope;for(int i=0;i<count;++i){require(static_cast<bool>(in>>tag>>text>>opening>>wall)&&tag=="CAP"&&scope.emplace(opening,wall).second,"interior door contract row");auto t=std::find_if(all.begin(),all.end(),[&](const DoorCaptionTarget& x){return x.opening==opening&&x.text==text;});require(t!=all.end(),"interior door does not match existing number");}in>>std::ws;require(in.eof(),"interior door trailing data");
 const auto furniture=captionFurniture(db);
 std::set<std::string> targets;for(const auto& t:all)if(scope.count(t.opening))targets.insert(t.text);require(targets.size()==scope.size(),"interior target coverage");std::ostringstream unused;auto fixed=doorCaptionObstacles(db,targets,unused,false);std::vector<std::pair<std::string,InkBox>> openings;std::vector<InkBox> walls;
 for(const auto& item:modelTypes(db)){const auto h=ascii(item.first);if(item.second==L"TDbOpening"||item.second==L"TDbGroupOpening")openings.push_back({h,doorCaptionBox(find(db,h))});if(item.second==L"TDbWall")walls.push_back(doorCaptionBox(find(db,h)));}
 struct Option{AcGePoint3d point;InkBox box;};struct Work{DoorCaptionTarget* t{};std::vector<bcpdoor::Stroke> ink;std::vector<Option> options;int side{};bool arc=false,keptForReview=false,wallOverlap=false,furnitureOverlap=false;};std::vector<Work> work;
 const auto overlap=[](const InkBox& a,const InkBox& b,double g){return a.xmin<b.xmax+g-1e-6&&a.xmax>b.xmin-g+1e-6&&a.ymin<b.ymax+g-1e-6&&a.ymax>b.ymin-g+1e-6;};
 for(auto& t:all)if(scope.count(t.opening)){
  Work w;w.t=&t;w.side=t.side;const auto own=doorCaptionBox(find(db,t.opening));{auto e=open<AcDbEntity>(find(db,t.opening));doorStrokes(*e,w.ink);}const bool vertical=std::abs(t.a.x-t.b.x)<1e-6;w.arc=std::any_of(w.ink.begin(),w.ink.end(),[](const bcpdoor::Stroke& s){return s.arc;});if(w.arc){const double c=vertical?t.a.x:t.a.y,negative=c-(vertical?own.xmin:own.ymin),positive=(vertical?own.xmax:own.ymax)-c;require(std::abs(positive-negative)>1,"door swing side is ambiguous");w.side=positive>negative?1:-1;}
  const auto id=find(db,t.text);const auto old=t.after;const auto original=doorCaptionBox(id);auto candidates=bcpdoor::candidates({t.a.x,t.a.y},{t.b.x,t.b.y},w.side,original.xmax-original.xmin,original.ymax-original.ymin,{own.xmin,own.ymin,own.xmax,own.ymax});
  const auto accepted=bcpdoor::safeCandidates(candidates,{old.x,old.y},[&](bcpdoor::Point p){
   const double normal=vertical?p.x-t.a.x:p.y-t.a.y;if(w.side*normal<=0)return false;
   setDoorCaptionPosition(db,id,{p.x,p.y,0});const auto b=doorCaptionBox(id);
   const bcpdoor::Box expanded{b.xmin-80,b.ymin-80,b.xmax+80,b.ymax+80};
   if(std::any_of(w.ink.begin(),w.ink.end(),[&](const bcpdoor::Stroke& stroke){return bcpdoor::hits(expanded,stroke);}))return false;
   if(std::any_of(openings.begin(),openings.end(),[&](const auto& e){return e.first!=t.opening&&overlap(b,e.second,80);})||std::any_of(fixed.begin(),fixed.end(),[&](const InkBox& x){return overlap(b,x,60);}))return false;
   const bool wallHit=std::any_of(walls.begin(),walls.end(),[&](const InkBox& x){return overlap(b,x,40);});if(wallHit&&!w.keptForReview)return false;if(w.keptForReview)w.wallOverlap=wallHit;
   const bool furnitureHit=captionFurnitureHit(b,furniture);if(furnitureHit&&!w.keptForReview)return false;if(w.keptForReview)w.furnitureOverlap=furnitureHit;
   w.options.push_back({{p.x,p.y,0},b});return true;
  },w.keptForReview);require(accepted.size()==w.options.size(),"door candidate tracking differs");
  setDoorCaptionPosition(db,id,old);if(w.options.empty()){std::ostringstream e;e<<"{\"opening\":\""<<t.opening<<"\",\"candidateCount\":"<<candidates.size()<<",\"safeCount\":0}";writeNew(fs::path(ini(config,L"receiptDirectory"))/L"interior-door-placement-failure.json",e.str());}require(!w.options.empty(),"no safe lower swing-side door number position");work.push_back(std::move(w));
 }
 std::vector<int> chosen(work.size(),-1);unsigned visits=0;std::function<bool(std::size_t)> solve=[&](std::size_t n){if(++visits>200000)return false;if(n==work.size())return true;std::size_t best=work.size();std::vector<int> available;for(std::size_t i=0;i<work.size();++i)if(chosen[i]<0){std::vector<int> possible;for(std::size_t k=0;k<work[i].options.size();++k){bool clear=true;for(std::size_t j=0;j<chosen.size();++j)if(chosen[j]>=0&&overlap(work[i].options[k].box,work[j].options[chosen[j]].box,60)){clear=false;break;}if(clear)possible.push_back(static_cast<int>(k));}if(possible.empty())return false;if(best==work.size()||possible.size()<available.size()){best=i;available=std::move(possible);}}for(int k:available){chosen[best]=k;if(solve(n+1))return true;chosen[best]=-1;}return false;};require(solve(0),"lower swing-side door numbers cannot be jointly placed");
 std::ostringstream sideIssues;const auto unknown=std::count_if(work.begin(),work.end(),[](const Work& w){return !w.arc;});sideIssues<<"DOORSIDE1 "<<unknown<<'\n';for(const auto& w:work)if(!w.arc)sideIssues<<"OPEN "<<w.t->opening<<'\n';writeNew(fs::path(ini(config,L"receiptDirectory"))/L"interior-door-side-confirmation.tsv",sideIssues.str());
 std::ostringstream review;review<<"DOORREVIEW1 "<<std::count_if(work.begin(),work.end(),[](const Work& w){return w.keptForReview;})<<'\n';for(const auto& w:work)if(w.keptForReview)review<<"OPEN "<<w.t->opening<<'\n';writeNew(fs::path(ini(config,L"receiptDirectory"))/L"interior-door-placement-review.tsv",review.str());
 std::ostringstream out;out<<std::setprecision(17)<<"{\"rule\":\"swing-side-lower-blank\",\"count\":"<<work.size()<<",\"furnitureAudit\":"<<captionFurnitureJson(furniture)<<",\"targets\":[";for(std::size_t i=0;i<work.size();++i){auto& w=work[i];auto& t=*w.t;t.after=w.options[chosen[i]].point;setDoorCaptionPosition(db,find(db,t.text),t.after);if(i)out<<',';out<<"{\"handle\":\""<<t.text<<"\",\"opening\":\""<<t.opening<<"\",\"wall\":\""<<scope.at(t.opening)<<"\",\"side\":"<<w.side<<",\"swingArcDetected\":"<<(w.arc?"true":"false")<<",\"keptForReview\":"<<(w.keptForReview?"true":"false")<<",\"wallOverlap\":"<<(w.wallOverlap?"true":"false")<<",\"furnitureOverlap\":"<<(w.furnitureOverlap?"true":"false")<<",\"candidateCount\":"<<w.options.size()<<",\"selected\":"<<chosen[i]<<",\"strokes\":[";for(std::size_t j=0;j<w.ink.size();++j){if(j)out<<',';const auto& s=w.ink[j];out<<"{\"arc\":"<<(s.arc?"true":"false")<<",\"a\":["<<s.x1<<','<<s.y1<<"],\"b\":["<<s.x2<<','<<s.y2<<"],\"center\":["<<s.cx<<','<<s.cy<<"],\"radius\":"<<s.radius<<",\"angle\":"<<s.angle<<",\"sweep\":"<<s.sweep<<'}';}out<<"]}";}out<<"]}";return out.str();
}
