void clipDimensionGap(AcDbDatabase& db,DrawnDimension& d,const std::string& side,double wall){
 AcDbExtents bounds;{auto e=open<AcDbEntity>(d.id);require(std::wstring(e->isA()->name())==L"TDbDimension2","gap target native type");status(e->getGeomExtents(bounds),"dimension display bounds");}
