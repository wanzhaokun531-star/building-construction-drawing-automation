 if(side=="bottom")high.y=wall-1000;else if(side=="top")low.y=wall+1000;else if(side=="left")high.x=wall-1000;else if(side=="right")low.x=wall+1000;else require(false,"dimension gap side invalid");
 require(low.x<high.x&&low.y<high.y,"dimension gap would remove entire annotation");d.clip.set(low,high);
 wchar_t handle[32]{};d.id.handle().getIntoAsciiBuffer(handle);const auto name=std::wstring(L"BCP_DIM_GAP_")+handle;auto block=std::make_unique<AcDbBlockTableRecord>();status(block->setName(name.c_str()),"dimension gap block name");AcDbObjectId definition;
 {auto table=editObject<AcDbBlockTable>(db.blockTableId());require(!table->has(name.c_str()),"dimension gap block exists");status(table->add(definition,block.get()),"dimension gap definition");}block.release()->close();
 {auto owner=editObject<AcDbBlockTableRecord>(definition);AcDbObjectIdArray one;one.append(d.id);status(owner->assumeOwnershipOf(one),"dimension native child ownership");}
 auto ref=std::make_unique<AcDbBlockReference>(AcGePoint3d::kOrigin,definition);ref->setDatabaseDefaults(&db);status(ref->setLayer(L"AXIS"),"dimension gap layer");{auto model=editObject<AcDbBlockTableRecord>(modelId(db));status(model->appendAcDbEntity(d.container,ref.get()),"dimension gap model reference");}ref.release()->close();
 auto placed=editObject<AcDbBlockReference>(d.container);status(placed->createExtensionDictionary(),"dimension gap dictionary");auto extension=editObject<AcDbDictionary>(placed->extensionDictionary());auto group=std::make_unique<AcDbDictionary>();AcDbObjectId filters;status(extension->setAt(L"ACAD_FILTER",group.get(),filters),"dimension filter collection");group.release()->close();
 auto filter=std::make_unique<AcDbSpatialFilter>();AcGePoint2dArray vertices;vertices.append({low.x,low.y});vertices.append({high.x,high.y});status(filter->setDefinition(vertices,AcGeVector3d::kZAxis,0,ACDB_INFINITE_XCLIP_DEPTH,ACDB_INFINITE_XCLIP_DEPTH,true),"dimension gap clipping definition");status(filter->setInverted(false),"dimension gap clip direction");{auto collection=editObject<AcDbDictionary>(filters);status(collection->setAt(L"SPATIAL",filter.get(),d.filter),"dimension gap attached filter");}filter.release()->close();
}
void verifyDimensionGap(AcDbDatabase& db,const DrawnDimension& d){
 if(d.container.isNull())return;AcDbObjectId native,container,filter;status(db.getAcDbObjectId(native,false,d.id.handle()),"saved dimension child");status(db.getAcDbObjectId(container,false,d.container.handle()),"saved dimension container");status(db.getAcDbObjectId(filter,false,d.filter.handle()),"saved dimension filter");
