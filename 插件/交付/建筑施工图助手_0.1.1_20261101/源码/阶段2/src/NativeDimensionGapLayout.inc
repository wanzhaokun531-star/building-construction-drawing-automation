 require(std::abs(vertices[0].x-d.clip.minPoint().x)<1e-6&&std::abs(vertices[0].y-d.clip.minPoint().y)<1e-6&&std::abs(vertices[1].x-d.clip.maxPoint().x)<1e-6&&std::abs(vertices[1].y-d.clip.maxPoint().y)<1e-6,"saved dimension clipping extent");require(db.xclipFrame()==0,"dimension clipping frame visible");
