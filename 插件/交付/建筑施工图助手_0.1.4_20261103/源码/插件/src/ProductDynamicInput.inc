struct ProductBatch {fs::path source,base,receipt;int panel=0;std::vector<fs::path> outputs;};
std::optional<ProductBatch> productBatch;
int productRequestedPanel=0;
bool productMatchesTwoPlan(AcDbDatabase& db,const fs::path& profile,int rootCount){std::ifstream input(profile/L"confirmed-input.tsv");require(static_cast<bool>(input),"confirmed two-plan geometry profile unavailable");auto plan=bcp::readCache(input);plan.sourceObjectCount=rootCount;try{verify(db,plan);return true;}catch(const std::exception&){return false;}}
bcp::Plan productPreparePanel(AcDbDatabase& db,ProductJob& job,std::map<std::wstring,std::wstring>& settings){
 require(job.panelIndex>=0&&job.panelIndex<2,"invalid confirmed panel index");
 const auto fields=productReadProperties(db,job.work/L"foundation/public-properties");auto whole=productCurrentPlan(db,job.sourceCopy,fields);whole.majorWallThickness=240;whole.partitionWallThickness=120;whole.partitionAxes=true;
 const auto panels=bcpproduct::splitPlanPanels(whole,2);auto panel=panels.at(job.panelIndex);std::set<std::string> removed;
 {Working work(&db);for(const auto& item:modelTypes(db)){auto e=open<AcDbEntity>(find(db,ascii(item.first)));AcDbExtents box;const auto result=e->getGeomExtents(box);bool keep=false;if(result==Acad::eOk){const double mid=(box.minPoint().x+box.maxPoint().x)/2;keep=mid>=panel.xmin&&mid<=panel.xmax&&box.minPoint().x>=panel.xmin&&box.maxPoint().x<=panel.xmax;}if(!keep)removed.insert(ascii(item.first));}
 writeNew(job.work/L"foundation/panel-erase-before.step",std::to_string(removed.size()));const auto before=wholeProtected(db,removed);for(const auto& h:removed){const auto id=find(db,h);if(id.isErased())continue;AcDbObjectId layer;{auto e=open<AcDbEntity>(id);layer=e->layerId();}bool locked=false;{auto record=open<AcDbLayerTableRecord>(layer);locked=record->isLocked();}if(locked){auto record=editObject<AcDbLayerTableRecord>(layer);record->setIsLocked(false);}try{auto e=editObject<AcDbEntity>(id);status(e->erase(),"omit other-floor object in owned work copy");}catch(...){if(locked){auto record=editObject<AcDbLayerTableRecord>(layer);record->setIsLocked(true);}throw;}if(locked){auto record=editObject<AcDbLayerTableRecord>(layer);record->setIsLocked(true);require(record->isLocked(),"restore work-copy layer lock");}}writeNew(job.work/L"foundation/panel-erase-after.step","all requested roots omitted");require(wholeProtected(db,{})==before,"floor separation changed retained public objects");}
 auto plan=std::move(panel.plan);plan.sourceObjectCount=static_cast<int>(modelTypes(db).size());job.currentPlan=plan;
 const auto cache=job.work/L"foundation/current-plan.tsv",exclusions=job.work/L"foundation/axis-exclusions.tsv",interior=job.work/L"foundation/interior.tsv",prefixes=job.work/L"foundation/prefixes.tsv";
 writeNew(cache,productPlanCache(plan));writeNew(exclusions,"S2AXISEXCLUSIONS1 "+plan.sourceSha+"\n");writeNew(interior,"S2INTERIORDIMS1 "+plan.sourceSha+"\n");writeNew(prefixes,"S2OPENINGPREFIXES1 "+plan.sourceSha+"\n");
 for(const auto& pair:std::vector<std::pair<std::wstring,fs::path>>{{L"cache",cache},{L"axisDecisions",exclusions},{L"interiorDimensionDecisions",interior},{L"openingPrefixes",prefixes}}){settings[pair.first]=pair.second.wstring();const auto hash=sha(pair.second);settings[pair.first+L"Hash"]={hash.begin(),hash.end()};}settings[L"dynamicInput"]=L"1";settings[L"receiptDirectory"]=(job.work/L"foundation").wstring();job.generationConfig=job.work/L"foundation/current-generation.ini";productIni(job.generationConfig,settings);
 std::ostringstream trace;trace<<"{\"panel\":"<<job.panelIndex+1<<",\"inputSHA256\":\""<<job.sourceHash<<"\",\"retainedModelRoots\":"<<plan.sourceObjectCount<<",\"walls\":"<<plan.walls.size()<<",\"openings\":"<<plan.openings.size()<<",\"omittedOtherPanelAndCrossingResources\":"<<removed.size()<<",\"retainedPublicObjectsUnchanged\":true}";writeNew(job.work/L"foundation/panel-input.json",trace.str());return plan;
}

void productVerifyLegacyParameters(AcDbDatabase& db,ProductJob& job,const bcp::Plan& plan){const auto fields=productReadProperties(db,job.work/L"foundation/public-properties");for(const auto& w:plan.walls){const auto& f=fields.at(w.handle);require(std::abs(bcpproduct::propertyNumber(f,L"左厚度")-w.left)<1e-6&&std::abs(bcpproduct::propertyNumber(f,L"右厚度")-w.right)<1e-6,u8"E_WALL_PARAMETERS：墙厚与已确认项目不同，请重新确认项目规则。");}for(const auto& o:plan.openings){const auto& f=fields.at(o.handle);if(std::abs(bcpproduct::propertyNumber(f,L"宽度")-o.width)>1e-6||std::abs(bcpproduct::propertyNumber(f,L"高度")-o.height)>1e-6)throw std::runtime_error(u8"E_OPENING_PARAMETERS：门窗 "+o.handle+u8" 的洞口宽高与已确认项目不同，请重新确认。");}}
