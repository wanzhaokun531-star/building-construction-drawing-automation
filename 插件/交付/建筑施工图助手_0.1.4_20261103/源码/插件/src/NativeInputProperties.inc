std::wstring productStringVar(const wchar_t* name){resbuf r{};const auto ret=acedGetVar(name,&r);std::wstring value;if(ret==RTNORM&&r.restype==RTSTR&&r.resval.rstring)value=r.resval.rstring;if(r.restype==RTSTR&&r.resval.rstring)acutDelString(r.resval.rstring);require(ret==RTNORM&&!value.empty(),"read logging path variable");return value;}
int productLogMode(){resbuf r{};require(acedGetVar(L"LOGFILEMODE",&r)==RTNORM&&r.restype==RTSHORT,"read logging mode");return r.resval.rint;}
void productSetLogMode(short mode){resbuf r{};r.restype=RTSHORT;r.resval.rint=mode;require(acedSetVar(L"LOGFILEMODE",&r)==RTNORM,"set owned logging mode");}
void productSetLogPath(const std::wstring& path){resbuf r{};r.restype=RTSTR;r.resval.rstring=const_cast<wchar_t*>(path.c_str());require(acedSetVar(L"LOGFILEPATH",&r)==RTNORM,"set owned logging path");}
struct ProductPublicListScope {
 std::wstring before;bool changed=false,done=false;fs::path log;
 explicit ProductPublicListScope(const fs::path& folder){require(productValidation()||(productJob&&curDoc()==productJob->ownedDocument),"public property capture requires owned document");require(productLogMode()==0,u8"E_LOGGING_BUSY：请先结束现有CAD日志记录，再读取项目参数。");before=productStringVar(L"LOGFILEPATH");fs::create_directories(folder);changed=true;try{productSetLogPath(folder.wstring()+L"\\");log=productStringVar(L"LOGFILENAME");require(fs::weakly_canonical(log.parent_path())==fs::weakly_canonical(folder)&&!fs::exists(log),"owned public-property log path differs");productSetLogMode(1);require(productLogMode()==1,"owned log did not enable");}catch(...){restore();throw;}}
 void restore()noexcept{if(done||!changed)return;try{productSetLogMode(0);if(productLogMode()!=0)return;productSetLogPath(before);done=bcpproduct::sameWindowsFolder(productStringVar(L"LOGFILEPATH"),before)&&productLogMode()==0;}catch(...){}}
 ~ProductPublicListScope(){restore();}
 void finish(){restore();require(done,"public property logging restore failed");}
};
std::string productUtf8(const std::wstring& text){if(text.empty())return {};const int n=WideCharToMultiByte(CP_UTF8,0,text.data(),static_cast<int>(text.size()),nullptr,0,nullptr,nullptr);require(n>0,"encode native property UTF8");std::string value(n,'\0');WideCharToMultiByte(CP_UTF8,0,text.data(),static_cast<int>(text.size()),&value[0],n,nullptr,nullptr);return value;}
std::map<std::string,bcpproduct::PublicProperties> productReadProperties(AcDbDatabase& db,const fs::path& folder){
 ProductPublicListScope log(folder);std::vector<std::string> handles;const auto tag=std::to_wstring(GetTickCount64());
 {Working work(&db);for(const auto& item:modelTypes(db)){if(item.second!=L"TDbWall"&&item.second!=L"TDbOpening"&&item.second!=L"TDbGroupOpening"&&item.second!=L"TDbText"&&item.second!=L"TDbDrawingName")continue;const auto h=ascii(item.first);handles.push_back(h);const auto begin=L"<BCP_BEGIN_"+tag+L"_"+item.first+L">";const auto end=L"<BCP_END_"+tag+L"_"+item.first+L">";acutPrintf(L"\n%ls\n",begin.c_str());{auto e=open<AcDbEntity>(find(db,h));e->list();}acutPrintf(L"\n%ls\n",end.c_str());}}
 log.finish();std::ifstream input(log.log,std::ios::binary);require(static_cast<bool>(input),"read native property log");const std::string raw((std::istreambuf_iterator<char>(input)),{});std::wstring text;if(raw.size()>=2&&static_cast<unsigned char>(raw[0])==255&&static_cast<unsigned char>(raw[1])==254){require((raw.size()-2)%2==0,"UTF16 property log length");text.resize((raw.size()-2)/2);memcpy(&text[0],raw.data()+2,raw.size()-2);}else text=bcpproduct::decodeMessage(raw);
 std::map<std::string,bcpproduct::PublicProperties> result;for(const auto& h:handles){const std::wstring id(h.begin(),h.end());const auto begin=L"<BCP_BEGIN_"+tag+L"_"+id+L">",end=L"<BCP_END_"+tag+L"_"+id+L">";const auto a=text.find(begin);require(a!=std::wstring::npos,"public property begin marker missing");const auto b=text.find(end,a+begin.size());require(b!=std::wstring::npos,"public property end marker missing");result[h]=bcpproduct::parseProperties(text.substr(a+begin.size(),b-a-begin.size()));}
 return result;
}
bcp::Plan productCurrentPlan(AcDbDatabase& db,const fs::path& source,const std::map<std::string,bcpproduct::PublicProperties>& fields){
 bcp::Plan plan;plan.sourceSha=sha(source);const auto inventory=productInventory(db);plan.sourceObjectCount=inventory.counts.objects;Working working(&db);
 for(const auto& item:modelTypes(db)){
  const auto h=ascii(item.first);auto f=fields.find(h);if(f==fields.end())continue;auto e=open<AcDbEntity>(find(db,h));
  if(item.second==L"TDbWall") {auto* curve=AcDbCurve::cast(e.get());require(curve,"native wall is not a public curve");AcGePoint3d a,b;status(curve->getStartPoint(a),"current wall start");status(curve->getEndPoint(b),"current wall end");const double left=bcpproduct::propertyNumber(f->second,L"左厚度"),right=bcpproduct::propertyNumber(f->second,L"右厚度");require(left>=0&&right>=0&&left+right>0,"current wall thickness invalid");plan.walls.push_back({h,{a.x,a.y},{b.x,b.y},left,right});}
  if(item.second==L"TDbOpening"||item.second==L"TDbGroupOpening") {AcGePoint3dArray gp;AcDbIntArray mode,ids;status(e->getGripPoints(gp,mode,ids),"current opening grips");require(gp.length()>=3,"current opening endpoints missing");bcp::Opening o;o.handle=h;o.a={gp[1].x,gp[1].y};o.b={gp[2].x,gp[2].y};o.width=bcpproduct::propertyNumber(f->second,L"宽度");o.height=bcpproduct::propertyNumber(f->second,L"高度");const auto kind=f->second.find(L"门窗类型");require(kind!=f->second.end(),"current opening kind missing");o.observedKind=item.second==L"TDbGroupOpening"?"G":kind->second==L"门"?"D":"W";o.confirmedPrefix=o.observedKind=="D"?"M":o.observedKind=="W"?"C":"";require(o.width>0&&o.height>0,"current opening parameters invalid");plan.openings.push_back(o);}
  if(item.second==L"TDbText"){auto text=f->second.find(L"文字内容");if(text==f->second.end()||text->second.empty())continue;AcDbExtents bounds;status(e->getGeomExtents(bounds),"current room text bounds");plan.rooms.push_back({h,{bounds.minPoint().x,bounds.minPoint().y},{bounds.maxPoint().x,bounds.maxPoint().y},productUtf8(text->second)});}
 }
 return plan;
}
std::string productPlanCache(const bcp::Plan& plan){std::ostringstream out;out<<std::setprecision(17)<<"S2READCACHE2 "<<plan.sourceSha<<' '<<plan.sourceObjectCount<<" mm\n";for(const auto& w:plan.walls)out<<"W "<<w.handle<<' '<<w.start.x<<' '<<w.start.y<<' '<<w.end.x<<' '<<w.end.y<<' '<<w.left<<' '<<w.right<<" U\n";for(const auto& o:plan.openings)out<<"O "<<o.handle<<' '<<o.a.x<<' '<<o.a.y<<' '<<o.b.x<<' '<<o.b.y<<' '<<o.width<<' '<<o.height<<' '<<o.observedKind<<' '<<(o.confirmedPrefix.empty()?"-":o.confirmedPrefix)<<'\n';for(const auto& r:plan.rooms){auto text=r.text;std::replace(text.begin(),text.end(),'\n',' ');std::replace(text.begin(),text.end(),'\t',' ');out<<"R\t"<<r.handle<<'\t'<<r.min.x<<'\t'<<r.min.y<<'\t'<<r.max.x<<'\t'<<r.max.y<<'\t'<<bcpproduct::cacheTextHex(text)<<'\n';}return out.str();}
