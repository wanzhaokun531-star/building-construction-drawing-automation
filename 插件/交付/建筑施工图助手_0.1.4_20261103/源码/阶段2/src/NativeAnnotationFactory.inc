void verifyDrawnAnnotations(AcDbDatabase& db,const DrawnAnnotations& drawn){Working work(&db);verifyFullAxisLines(db,drawn);if(drawn.unified)verifyUnified(db,drawn);if(drawn.anchoredDirect){auto observed=drawn;verifyDirectThird(db,observed,false);verifyAllNativeDimensionEditing(db,observed,false);verifyNativeApron(db,drawn);verifyWitnessMasks(db,drawn);}for(const auto layer:drawn.legacyFrameLayers){AcDbObjectId id;status(db.getAcDbObjectId(id,false,layer.handle()),"saved legacy frame layer");auto record=open<AcDbLayerTableRecord>(id);require(record->isOff(),"saved legacy frame layer on");}for(const auto& guide:drawn.guides){AcDbObjectId id;status(db.getAcDbObjectId(id,false,guide.id.handle()),"saved trial guide");auto e=open<AcDbLine>(id);require((e->startPoint()-guide.a).length()<1e-6&&(e->endPoint()-guide.b).length()<1e-6&&e->colorIndex()==8,"saved trial guide differs");}for(const auto original:drawn.suppressed){AcDbObjectId saved;status(db.getAcDbObjectId(saved,false,original.handle()),"saved source dimension id");auto e=open<AcDbEntity>(saved);require(std::wstring(e->isA()->name())==L"TDbDimension2"&&e->visibility()==AcDb::kInvisible,"superseded source dimension visibility/type differs");}for(const auto& axis:drawn.axes){AcDbHandle handle;handle=axis.id.handle();AcDbObjectId id;status(db.getAcDbObjectId(id,false,handle),"saved axis handle");validateAxisCaption(id,axis.label);verifyAxisContainer(db,axis);const auto ink=axisInk(id,axis.vertical);for(int i=0;i<2;++i)require((ink.circles[i].centre-axis.expected.circles[i].centre).length()<1e-6&&std::abs(ink.circles[i].radius-axis.expected.circles[i].radius)<1e-6,"saved native axis display differs");auto root=open<AcDbEntity>(id);AcGePoint3dArray points;AcDbIntArray modes,geometry;status(root->getGripPoints(points,modes,geometry),"saved axis points");require(points.length()==8&&std::abs((axis.vertical?points[0].x:points[0].y)-axis.coordinate)<=1e-6,"saved axis station differs");}for(const auto& dimension:drawn.dimensions){verifyDimensionGap(db,dimension);AcDbHandle handle;handle=dimension.id.handle();AcDbObjectId id;status(db.getAcDbObjectId(id,false,handle),"saved dimension handle");require(std::abs(nativeDimensionMeasurement(id)-dimension.expected)<=1e-6,"saved dimension actual value differs");}}
