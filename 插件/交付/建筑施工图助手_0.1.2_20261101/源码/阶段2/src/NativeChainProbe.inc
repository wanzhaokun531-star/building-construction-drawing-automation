 const bool vertical=std::abs(gp[0].x-gp[1].x)<1e-6;const auto along=vertical?AcGeVector3d(0,40,0):AcGeVector3d(40,0,0);const double direction=(vertical?gp[3].y-gp[2].y:gp[3].x-gp[2].x)>0?1:-1;moveDimensionGrip(id,3,gp[3]+along*direction);const auto changed=chainValues(id);int increases=0,decreases=0,unchanged=0;for(int i=0;i<n;++i){const double delta=changed[i]-originalValues[i];if(std::abs(delta-40)<1e-6)++increases;else if(std::abs(delta+40)<1e-6)++decreases;else if(std::abs(delta)<1e-6)++unchanged;else require(false,"single shared TCH node did not update exactly two segments");}require(increases==1&&decreases==1&&unchanged==n-2,"shared TCH node not genuinely linked");moveDimensionGrip(id,3,gp[3]);
