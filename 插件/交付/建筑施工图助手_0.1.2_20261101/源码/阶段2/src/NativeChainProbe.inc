 report<<"],\"kitchenSample\":";const auto sample=cloneOne(reference,find(reference,"1A40"),db);auto initial=chainGrips(sample);{auto e=editObject<AcDbEntity>(sample);status(e->transformBy(AcGeMatrix3d::translation(AcGePoint3d(25311.890259172244,30841.263551952827,0)-initial[2])),"position one TCH chain at actual kitchen");}const std::vector<double> stations{30841.263551952827,31541.263551952827,33941.263551952827,34641.263551952827};for(int i=3;i>=0;--i)moveDimensionGrip(sample,2+i,{25311.890259172244,stations[i],0});auto sampleGp=chainGrips(sample);moveDimensionGrip(sample,0,{26511.890259172244,sampleGp[0].y,0});const auto actualKitchen=chainValues(sample);require(actualKitchen.size()==3&&std::abs(actualKitchen[0]-700)<1e-6&&std::abs(actualKitchen[1]-2400)<1e-6&&std::abs(actualKitchen[2]-700)<1e-6,"actual one-object kitchen width chain differs");sampleGp=chainGrips(sample);moveDimensionGrip(sample,3,sampleGp[3]+AcGeVector3d(0,40,0));const auto linkedKitchen=chainValues(sample);require(std::abs(linkedKitchen[0]-740)<1e-6&&std::abs(linkedKitchen[1]-2360)<1e-6&&std::abs(linkedKitchen[2]-700)<1e-6,"actual kitchen not one-node linked");moveDimensionGrip(sample,3,sampleGp[3]);report<<"{\"handle\":\""<<axisHandle(sample)<<"\",\"values\":"<<chainProbeNumbers(actualKitchen)<<",\"oneNodeChangedValues\":"<<chainProbeNumbers(linkedKitchen)<<",\"singleEntity\":true,\"ownerModel\":true}";
 const auto output=receipt/L"厨房连续天正尺寸_仅能力试验.dwg";status(db.saveAs(output.c_str(),false,AcDb::kDHL_CURRENT),"save native one-object chain proof");AcDbDatabase saved(false,true);status(saved.readDwgFile(output.c_str(),AcDbDatabase::kForReadAndAllShare,false),"reopen chain proof");status(saved.closeInput(true),"close chain proof input");{Working w(&saved);AcDbObjectId actual;status(saved.getAcDbObjectId(actual,false,sample.handle()),"saved kitchen chain");require(chainGrips(actual).size()==12&&chainValues(actual)==actualKitchen,"saved kitchen true multi-chain changed");const auto types=modelTypes(saved);for(const auto& old:original)require(types.at(old.first)==old.second,"chain proof changed original type");}report<<",\"savedReopened\":true,\"outputSHA256\":\""<<sha(output)<<"\",\"error\":null}";writeNew(receipt/L"chain-probe.json",report.str());require(modelTypes(db).size()==original.size()+6,"chain probe unexpected roots");require(sha(input)==ascii(ini(config,L"chainInputHash")),"chain input changed");writeNew(receipt/L"stage2-analysis.done",report.str());
