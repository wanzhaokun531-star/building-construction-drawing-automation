std::vector<double> chainValues(AcDbObjectId id){auto e=open<AcDbEntity>(id);TemplateParts parts(e.get());status(e->explode(parts.values),"chain public dimension display");std::vector<double> values;for(int i=0;i<parts.values.length();++i){auto* d=AcDbAlignedDimension::cast(static_cast<AcRxObject*>(parts.values[i]));require(d&&d->objectId().isNull()&&d->ownerId().isNull()&&!d->database(),"chain has non-native dimension display");double v{};status(d->measurement(v),"chain submeasurement");values.push_back(v);}return values;}
std::string chainProbeNumbers(const std::vector<double>& v){std::ostringstream s;s<<std::setprecision(17)<<'[';for(std::size_t i=0;i<v.size();++i){if(i)s<<',';s<<v[i];}s<<']';return s.str();}
