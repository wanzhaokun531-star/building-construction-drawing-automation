void saveAxisReferenceStudy(const std::wstring& config,AcDbDatabase& reference){
 if(GetPrivateProfileIntW(L"stage2",L"axisReferenceStudy",0,config.c_str())!=1)return;
 const fs::path source=ini(config,L"source"),folder=ini(config,L"receiptDirectory");AcDbDatabase scene(false,true);
 status(scene.readDwgFile(source.c_str(),AcDbDatabase::kForReadAndAllShare,false),"reference-study fixed base");status(scene.closeInput(true),"reference-study finish base");
 {Working sceneWork(&scene);auto model=open<AcDbBlockTableRecord>(modelId(scene));AcDbBlockTableRecordIterator* raw{};status(model->newIterator(raw),"study base iterator");std::unique_ptr<AcDbBlockTableRecordIterator> it(raw);for(;!it->done();it->step()){AcDbObjectId id;status(it->getEntityId(id),"study base id");auto e=editObject<AcDbEntity>(id);status(e->setVisibility(AcDb::kInvisible),"study hide unrelated geometry");}}
 AcDbObjectIdArray selected;{Working sourceWork(&reference);auto model=open<AcDbBlockTableRecord>(modelId(reference));AcDbBlockTableRecordIterator* raw{};status(model->newIterator(raw),"reference axis iterator");std::unique_ptr<AcDbBlockTableRecordIterator> it(raw);for(;!it->done();it->step()){AcDbObjectId id;status(it->getEntityId(id),"reference axis id");auto e=open<AcDbEntity>(id);const auto layer=symbolName(e->layerId());if(layer!=L"AXIS"&&layer!=L"A-DOTE")continue;const std::wstring type=e->isA()->name();require(type==L"TDbAxisLabelSet"||type==L"TDbDimension2"||type==L"AcDbLine","unexpected reference axis resource");selected.append(id);}}
 if(selected.length()!=26)throw std::runtime_error("reference axis study selection differs: "+std::to_string(selected.length()));Working sceneWrite(&scene);AcDbIdMapping mapping;status(reference.wblockCloneObjects(selected,modelId(scene),mapping,AcDb::kDrcMangleName,false),"reference study isolated cloning");
