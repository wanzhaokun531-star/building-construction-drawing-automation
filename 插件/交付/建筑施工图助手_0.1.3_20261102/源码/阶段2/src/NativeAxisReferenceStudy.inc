 const auto output=folder/L"reference-axis-study.dwg";require(!fs::exists(output),"reference study output exists");status(scene.saveAs(output.c_str(),false,AcDb::kDHL_CURRENT),"save reference axis study");std::ostringstream report;report<<"{\"contract\":\"bcp.reference-axis-study.v1\",\"referenceSHA256\":\""<<sha(fs::path(ini(config,L"reference")))<<"\",\"sourceSHA256\":\""<<sha(source)<<"\",\"sourceHiddenRoots\":213,\"referenceAxisRoots\":26,\"outputModelCount\":239,\"output\":\""<<output.generic_u8string()<<"\",\"DWGSHA256\":\""<<sha(output)<<"\",\"fontSubstitution\":false,\"referenceOriginalChanged\":false}";
 writeNew(folder/L"reference-axis-study.json",report.str());
