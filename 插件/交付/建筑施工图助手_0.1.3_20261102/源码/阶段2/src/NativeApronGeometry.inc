// Geometry and source evidence only. Slope/level semantics are kept pending.
std::vector<bcp::Point> apronPolylinePoints(AcDbObjectId id){auto p=open<AcDbPolyline>(id);require(p->numVerts()>=2&&p->isOnlyLines(),"apron reference must contain public straight polyline segments");std::vector<bcp::Point> points;for(unsigned i=0;i<p->numVerts();++i){AcGePoint2d point;status(p->getPointAt(i,point),"apron public point");points.push_back({point.x,point.y});}return points;}
std::string apronPointsJson(const std::vector<bcp::Point>& points){std::ostringstream s;s<<std::setprecision(17)<<'[';for(std::size_t i=0;i<points.size();++i){if(i)s<<',';s<<'['<<points[i].x<<','<<points[i].y<<']';}s<<']';return s.str();}
std::wstring apronPendingNoteText(){const std::wstring sep=AcDbMText::paragraphBreak();return L"散水600"+sep+L"坡度待确认"+sep+L"分段标高待确认"+sep+L"中央庭院边界待确认";}
void drawNativeApron(AcDbDatabase& db,AcDbDatabase& reference,const bcp::Plan& p,const bcp::Result& result,DrawnAnnotations& drawn){
 const auto ref=apronPolylinePoints(find(reference,"19FE"));double rxmin=ref.front().x,rxmax=rxmin,rymax=ref.front().y;for(const auto& q:ref){rxmin=std::min(rxmin,q.x);rxmax=std::max(rxmax,q.x);rymax=std::max(rymax,q.y);}std::vector<double> measured;for(const auto& h:std::vector<std::string>{"17F6","17F7","17F8"}){auto wall=open<AcDbEntity>(find(reference,h));AcDbExtents box;status(wall->getGeomExtents(box),"reference apron wall face");measured.push_back(h=="17F6"?box.minPoint().x-rxmin:h=="17F7"?rymax-box.maxPoint().y:rxmax-box.maxPoint().x);}for(double value:measured)require(std::abs(value-600)<1e-6,"reference apron width not confirmed in three directions");const double width=measured[0];const auto& body=result.topology.outerBodyContours.at(0);std::vector<bcp::ApronInterruption> cuts;std::ostringstream cutEvidence;cutEvidence<<std::setprecision(17)<<'[';bool firstCut=true;
 const auto addCut=[&](bcp::Point a,bcp::Point b,const std::string& source){if(std::hypot(a.x-b.x,a.y-b.y)<=1e-6)return;cuts.push_back({a,b});if(!firstCut)cutEvidence<<',';firstCut=false;cutEvidence<<"{\"source\":\""<<source<<"\",\"points\":"<<apronPointsJson({a,b})<<'}';};
 for(const auto& chain:result.chains){const auto w=std::find_if(p.walls.begin(),p.walls.end(),[&](const bcp::Wall& w){return w.handle==chain.wall;});const auto role=std::find_if(result.topology.walls.begin(),result.topology.walls.end(),[&](const bcp::WallRecognition& r){return r.handle==chain.wall;});if(w==p.walls.end()||role==result.topology.walls.end()||role->role!=bcp::WallRole::exterior)continue;const auto centre=bcp::bodyCentreStart(*w);const bool vertical=std::abs(w->start.x-w->end.x)<1e-6;const double across=vertical?centre.x:centre.y,half=(w->left+w->right)/2;
  for(const auto& h:chain.openings){const auto o=std::find_if(p.openings.begin(),p.openings.end(),[&](const bcp::Opening& o){return o.handle==h;});require(o!=p.openings.end(),"apron door absent");if(o->observedKind!="D"&&o->observedKind!="G")continue;auto a=o->a,b=o->b;if(o->observedKind=="G"){const auto endpoints=bcp::resolveGroupEndpoints(*o,p.walls);require(endpoints.has_value(),"apron grouped entrance unresolved");a=endpoints->first;b=endpoints->second;}const double lo=vertical?std::min(a.y,b.y):std::min(a.x,b.x),hi=vertical?std::max(a.y,b.y):std::max(a.x,b.x);int matched=0;
   for(std::size_t i=0;i<body.size();++i){const auto x=body[i],y=body[(i+1)%body.size()];if(vertical!= (std::abs(x.x-y.x)<1e-6))continue;const double face=vertical?x.x:x.y;if(std::abs(std::abs(face-across)-half)>1e-6)continue;const double edgeLo=vertical?std::min(x.y,y.y):std::min(x.x,y.x),edgeHi=vertical?std::max(x.y,y.y):std::max(x.x,y.x);const double from=std::max(lo,edgeLo),to=std::min(hi,edgeHi);if(to-from>1e-6){addCut(vertical?bcp::Point{face,from}:bcp::Point{from,face},vertical?bcp::Point{face,to}:bcp::Point{to,face},h);++matched;}}
   require(matched==1,"exterior entry does not uniquely intersect verified body face");
  }
 }
 // The three existing entrance step outlines and actual door-wall face define
 // the fixed scheme's interruption extent. No riser/tread parameter is inferred.
 double pxmin=0,pxmax=0,pymin=1e100,pymax=0;for(const auto& h:std::vector<std::string>{"CEDF","CEE0","CEE1"}){auto e=open<AcDbEntity>(find(db,h));AcDbExtents box;status(e->getGeomExtents(box),"scheme entrance step boundary");if(pxmin==0){pxmin=box.minPoint().x;pxmax=box.maxPoint().x;}require(std::abs(box.minPoint().x-pxmin)<1e-6&&std::abs(box.maxPoint().x-pxmax)<1e-6&&std::abs(box.minPoint().y-box.maxPoint().y)<1e-6,"step outline cannot define aligned interruption");pymin=std::min(pymin,box.minPoint().y);} {auto e=open<AcDbEntity>(find(db,"CD93"));AcDbExtents box;status(e->getGeomExtents(box),"porch entry wall face");pymax=box.minPoint().y;}require(pxmin<pxmax&&pymin<pymax,"porch interruption bounds invalid");
 for(std::size_t i=0;i<body.size();++i){const auto a=body[i],b=body[(i+1)%body.size()];const bool vertical=std::abs(a.x-b.x)<1e-6;const double across=vertical?a.x:a.y;if(across<(vertical?pxmin:pymin)-1e-6||across>(vertical?pxmax:pymax)+1e-6)continue;const double lo=std::max(vertical?std::min(a.y,b.y):std::min(a.x,b.x),vertical?pymin:pxmin),hi=std::min(vertical?std::max(a.y,b.y):std::max(a.x,b.x),vertical?pymax:pxmax);if(hi-lo>1e-6)addCut(vertical?bcp::Point{across,lo}:bcp::Point{lo,across},vertical?bcp::Point{across,hi}:bcp::Point{hi,across},"porch-step-envelope");}cutEvidence<<']';const auto shape=bcp::makeApronOutline(body,width,cuts);
 const auto append=[&](const std::vector<bcp::Point>& points,bool closed,const std::string& kind){require(points.size()>=2,"empty apron output path");auto line=std::make_unique<AcDbPolyline>();line->setDatabaseDefaults(&db);for(std::size_t i=0;i<points.size();++i)status(line->addVertexAt(static_cast<unsigned>(i),{points[i].x,points[i].y},0,0,0),"apron native path vertex");line->setClosed(closed);status(line->setLayer(L"AXIS"),"apron initial layer");AcDbObjectId id;{auto model=editObject<AcDbBlockTableRecord>(modelId(db));status(model->appendAcDbEntity(id,line.get()),"apron native model path");}line.release()->close();drawn.apronStrokes.push_back({id,points,closed,kind});};
 for(const auto& path:shape.paths)append(path.points,path.closed,"outline");for(const auto& joint:shape.convexCornerJoints)append({joint.a,joint.b},false,"corner-joint");
 AcDbObjectId style;{auto table=open<AcDbTextStyleTable>(db.textStyleTableId());status(table->getAt(L"BCP_PENDING_CN",style),"apron pending font");}double xmax=body.front().x,ymin=body.front().y;for(const auto& q:body){xmax=std::max(xmax,q.x);ymin=std::min(ymin,q.y);}auto note=std::make_unique<AcDbMText>();note->setDatabaseDefaults(&db);status(note->setTextStyle(style),"apron note style");status(note->setTextHeight(200),"apron note height");status(note->setWidth(2600),"apron note width");AcDbExtents courtyardNoteBounds;{auto boundary=open<AcDbEntity>(find(db,"CF5D"));status(boundary->getGeomExtents(courtyardNoteBounds),"existing grey courtyard bounds for note placement only");}status(note->setLocation({courtyardNoteBounds.minPoint().x+500,courtyardNoteBounds.maxPoint().y-250,0}),"apron note position");status(note->setAttachment(AcDbMText::kTopLeft),"apron note attachment");const std::wstring noteValue=apronPendingNoteText();const auto contentsStatus=note->setContents(noteValue.c_str());ACHAR* readback=note->contents();const bool same=readback&&std::wstring(readback)==noteValue;if(readback)acdbFree(readback);require(same,(std::string("apron note content readback failed, return=")+std::to_string(contentsStatus)).c_str());status(note->setLayer(L"AXIS"),"apron note initial layer");AcDbObjectId noteId;{auto model=editObject<AcDbBlockTableRecord>(modelId(db));status(model->appendAcDbEntity(noteId,note.get()),"apron pending note");}note.release()->close();drawn.apronTexts.push_back(noteId);
 std::ostringstream report;report<<std::setprecision(17)<<"{\"enabled\":true,\"width\":"<<width<<",\"referenceWidths\":["<<measured[0]<<','<<measured[1]<<','<<measured[2]<<"],\"referencePolyline\":\"19FE\",\"referenceWallHandles\":[\"17F6\",\"17F7\",\"17F8\"],\"referencePoints\":"<<apronPointsJson(ref)<<",\"body\":"<<apronPointsJson(shape.innerContour)<<",\"offsetDiagnosticOnly\":"<<apronPointsJson(shape.offsetOuterContour)<<",\"cuts\":"<<cutEvidence.str()<<",\"porchBounds\":["<<pxmin<<','<<pymin<<','<<pxmax<<','<<pymax<<"],\"interruptions\":"<<shape.interruptionComponentCount<<",\"paths\":[";for(std::size_t i=0;i<drawn.apronStrokes.size();++i){if(i)report<<',';const auto& v=drawn.apronStrokes[i];report<<"{\"handle\":\""<<axisHandle(v.id)<<"\",\"kind\":\""<<v.kind<<"\",\"closed\":"<<(v.closed?"true":"false")<<",\"points\":"<<apronPointsJson(v.points)<<'}';}report<<"],\"note\":\""<<axisHandle(noteId)<<"\",\"pending\":[\"slope-and-discharge\",\"wall-side-level-region-mapping\",\"central-courtyard-grey-boundary-and-covered-walkway\"],\"drainGenerated\":false}";drawn.apronReport=report.str();
}
void verifyNativeApron(AcDbDatabase& db,const DrawnAnnotations& drawn){for(const auto& s:drawn.apronStrokes){AcDbObjectId id;status(db.getAcDbObjectId(id,false,s.id.handle()),"saved apron path");auto e=open<AcDbPolyline>(id);require(e->ownerId()==modelId(db)&&e->isClosed()==s.closed&&std::wstring(e->layer())==L"A-GROUND","saved apron path ownership/layer");const auto actual=apronPolylinePoints(id);require(actual.size()==s.points.size(),"saved apron vertex count");for(std::size_t i=0;i<actual.size();++i)require(std::hypot(actual[i].x-s.points[i].x,actual[i].y-s.points[i].y)<1e-6,"saved apron actual point differs");}for(const auto old:drawn.apronTexts){AcDbObjectId id;status(db.getAcDbObjectId(id,false,old.handle()),"saved apron note");auto e=open<AcDbMText>(id);require(e->ownerId()==modelId(db)&&std::wstring(e->layer())==L"A-PUB_TEXT","saved apron pending note layer");ACHAR* contents=e->contents();const bool same=contents&&std::wstring(contents)==apronPendingNoteText();if(contents)acdbFree(contents);require(same&&std::abs(e->width()-2600)<1e-6&&std::abs(e->textHeight()-200)<1e-6,"saved apron note contents or layout changed");}}
