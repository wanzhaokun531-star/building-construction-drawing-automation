// Read-only display/plot diagnostic for a separately saved stage2 intermediate.
#include "UniqueRawParts.h"
struct Stage2PreviewParts {
 AcDbVoidPtrArray values;const AcDbEntity* root;
 explicit Stage2PreviewParts(const AcDbEntity* p):root(p){}
 ~Stage2PreviewParts(){nativeparts::forEachDistinct(values,[&](void* raw){auto* e=AcDbEntity::cast(static_cast<AcRxObject*>(raw));if(e&&e!=root&&e->database()==nullptr&&e->objectId().isNull()&&e->ownerId().isNull())delete e;});}
};
std::string stage2DimensionClip(AcDbDatabase& db,AcDbObjectId child){
 AcDbObjectId owner;{auto e=open<AcDbEntity>(child);owner=e->ownerId();}const auto ids=modelIds(db);AcDbObjectId container;int found=0;
 for(int i=0;i<ids.length();++i){auto e=open<AcDbEntity>(ids[i]);auto* ref=AcDbBlockReference::cast(e.get());if(ref&&ref->blockTableRecord()==owner){container=ids[i];++found;}}
 if(!found)return "null";if(found!=1)throw std::runtime_error("dimension clip parent not unique");auto ref=open<AcDbBlockReference>(container);if(!ref->blockTransform().isEqualTo(AcGeMatrix3d::kIdentity))throw std::runtime_error("dimension clip moved actual measurement");auto dict=open<AcDbDictionary>(ref->extensionDictionary());AcDbObjectId collection,filter;check(dict->getAt(L"ACAD_FILTER",collection),"diagnostic gap filter collection");auto list=open<AcDbDictionary>(collection);check(list->getAt(L"SPATIAL",filter),"diagnostic gap filter link");auto f=open<AcDbSpatialFilter>(filter);AcGePoint2dArray vertices;AcGeVector3d normal;double elevation{},front{},back{};Adesk::Boolean enabled=false;check(f->getDefinition(vertices,normal,elevation,front,back,enabled),"diagnostic saved clipping bounds");if(!enabled||f->isInverted()||vertices.length()!=2||!normal.isEqualTo(AcGeVector3d::kZAxis)||elevation!=0)throw std::runtime_error("diagnostic invalid gap clipping");wchar_t h[32]{};container.handle().getIntoAsciiBuffer(h);std::ostringstream out;out<<"{\"container\":"<<quote(h)<<",\"min\":["<<number(vertices[0].x)<<','<<number(vertices[0].y)<<"],\"max\":["<<number(vertices[1].x)<<','<<number(vertices[1].y)<<"],\"identityTransform\":true}";return out.str();
}
