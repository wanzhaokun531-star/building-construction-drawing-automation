// SDK editing of actual TCH dimensions; no anonymous wrapper or business command.
std::vector<AcGePoint3d> dimensionEditSnapshot(AcDbObjectId id){auto e=open<AcDbEntity>(id);AcGePoint3dArray gp;AcDbIntArray mode,geometry;status(e->getGripPoints(gp,mode,geometry),"native dimension editing points");require(gp.length()==8,"native editable dimension shape");std::vector<AcGePoint3d> result;for(int i=0;i<8;++i)result.push_back(gp[i]);return result;}
void restoreDimensionEdit(AcDbObjectId id,const std::vector<AcGePoint3d>& gp){moveDimensionGrip(id,2,gp[2]);moveDimensionGrip(id,3,gp[3]);moveDimensionGrip(id,0,gp[0]);moveDimensionGrip(id,4,gp[4]);const auto actual=dimensionEditSnapshot(id);for(int i=0;i<8;++i)require((actual[i]-gp[i]).length()<1e-6,"native editing did not restore all grip points");}
void verifyAllNativeDimensionEditing(AcDbDatabase& db,DrawnAnnotations& drawn,bool probe){
 if(!drawn.allDirectDimensions)return;std::map<std::string,std::vector<const DrawnDimension*>> chains;
 for(const auto& d:drawn.dimensions){AcDbObjectId id;status(db.getAcDbObjectId(id,false,d.id.handle()),"saved direct dimension");{auto e=open<AcDbEntity>(id);require(e->ownerId()==modelId(db)&&std::wstring(e->isA()->name())==L"TDbDimension2"&&!e->isAProxy()&&d.container.isNull()&&d.filter.isNull(),"new dimension still wrapped or non-TCH");}chains[d.row+":"+(d.sourceWall.empty()?d.side:d.sourceWall)].push_back(&d);
  if(!probe)continue;const auto before=dimensionEditSnapshot(id);const auto normal=d.vertical?AcGeVector3d(120,0,0):AcGeVector3d(0,120,0);moveDimensionGrip(id,0,before[0]+normal);auto moved=dimensionEditSnapshot(id);require((moved[0]-before[0]-normal).length()<1e-6&&(moved[2]-before[2]).length()<1e-6&&(moved[3]-before[3]).length()<1e-6,"dimension baseline drag changed architecture measurement");restoreDimensionEdit(id,before);
  const auto delta=(before[3]-before[2]).normal()*40;moveDimensionGrip(id,2,before[2]+delta);moved=dimensionEditSnapshot(id);require((moved[2]-before[2]-delta).length()<1e-6&&(moved[3]-before[3]).length()<1e-6&&std::abs(nativeDimensionMeasurement(id)-(d.expected-40))<1e-6,"native measuring grip cannot stretch dimension value");restoreDimensionEdit(id,before);require(std::abs(nativeDimensionMeasurement(id)-d.expected)<1e-6,"restored native value differs");++drawn.allDimensionEditChecks;
 }
 if(!probe)return;
 for(auto& item:chains){auto& chain=item.second;std::sort(chain.begin(),chain.end(),[](const DrawnDimension* a,const DrawnDimension* b){return a->axisFrom<b->axisFrom;});std::vector<std::vector<AcGePoint3d>> before;for(const auto* d:chain)before.push_back(dimensionEditSnapshot(d->id));const auto normal=chain.front()->vertical?AcGeVector3d(-120,0,0):AcGeVector3d(0,-120,0);
  for(std::size_t i=0;i<chain.size();++i)moveDimensionGrip(chain[i]->id,0,before[i][0]+normal);
  for(std::size_t i=0;i<chain.size();++i){const auto actual=dimensionEditSnapshot(chain[i]->id);require((actual[0]-before[i][0]-normal).length()<1e-6&&(actual[2]-before[i][2]).length()<1e-6&&(actual[3]-before[i][3]).length()<1e-6,"whole chain move split plane or changed endpoints");restoreDimensionEdit(chain[i]->id,before[i]);}++drawn.chainMoveChecks;
  for(std::size_t i=1;i<chain.size();++i){const auto& a=before[i-1];const auto& b=before[i];if((a[3]-b[2]).length()>1e-6)continue;const auto delta=(a[3]-a[2]).normal()*40;moveDimensionGrip(chain[i-1]->id,3,a[3]+delta);moveDimensionGrip(chain[i]->id,2,b[2]+delta);const auto ga=dimensionEditSnapshot(chain[i-1]->id),gb=dimensionEditSnapshot(chain[i]->id);require((ga[3]-gb[2]).length()<1e-6&&(ga[3]-a[3]-delta).length()<1e-6&&std::abs(nativeDimensionMeasurement(chain[i-1]->id)-(chain[i-1]->expected+40))<1e-6&&std::abs(nativeDimensionMeasurement(chain[i]->id)-(chain[i]->expected-40))<1e-6,"shared split point stretch broke continuous dimensions");restoreDimensionEdit(chain[i-1]->id,a);restoreDimensionEdit(chain[i]->id,b);++drawn.sharedJointEditChecks;}
 }
 require(drawn.allDimensionEditChecks==static_cast<int>(drawn.dimensions.size())&&drawn.sharedJointEditChecks>0&&drawn.chainMoveChecks>0,"all native dimension interaction proof incomplete");
}
std::string interiorDimensionReviewJson(const DrawnAnnotations& d){std::ostringstream s;s<<"{\"enabled\":"<<(d.allDirectDimensions?"true":"false")<<",\"decisionsSHA256\":\""<<d.interiorDecisionHash<<"\",\"omittedWalls\":[";bool first=true;for(const auto& w:d.omittedInternalWalls){if(!first)s<<',';first=false;s<<'"'<<w<<'"';}s<<"],\"decisions\":[";first=true;for(const auto& v:d.interiorDecisions){if(!first)s<<',';first=false;s<<"{\"wall\":\""<<v.first<<"\",\"action\":\""<<(v.second==bcp::InteriorDimensionAction::omit?"OMIT":v.second==bcp::InteriorDimensionAction::left?"LEFT":"DOWN")<<"\"}";}s<<"]}";return s.str();}
