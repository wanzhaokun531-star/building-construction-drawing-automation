struct ScopedNativeMaskFrame {
 bool enabled=false,restored=false;short before=0,frameBefore=0;
 static short get(const wchar_t* name){resbuf value{};require(acedGetVar(name,&value)==RTNORM&&value.restype==RTSHORT,"native mask variable read failed");return value.resval.rint;}
 static void set(const wchar_t* name,short value){resbuf v{};v.restype=RTSHORT;v.resval.rint=value;require(acedSetVar(name,&v)==RTNORM,"native mask variable set failed");}
 explicit ScopedNativeMaskFrame(bool on):enabled(on){if(!on)return;require(curDoc()&&curDoc()->database()==acdbHostApplicationServices()->workingDatabase(),"mask environment requires own current scratch document");before=get(L"WIPEOUTFRAME");frameBefore=get(L"FRAME");try{set(L"WIPEOUTFRAME",0);require(get(L"WIPEOUTFRAME")==0,"mask frame variable did not apply");}catch(...){restore();throw;}}
 bool restore()noexcept{if(restored||!enabled)return true;try{set(L"WIPEOUTFRAME",before);if(frameBefore!=3&&get(L"FRAME")!=frameBefore)set(L"FRAME",frameBefore);restored=get(L"WIPEOUTFRAME")==before&&get(L"FRAME")==frameBefore;return restored;}catch(...){return false;}}
 void finish(){require(restore(),"own scratch mask variables not restored");}
 ~ScopedNativeMaskFrame(){restore();}
};
