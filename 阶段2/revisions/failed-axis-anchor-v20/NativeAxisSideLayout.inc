double pointSegmentDistance(const AcGePoint3d& p,const AcGePoint3d& a,const AcGePoint3d& b){const auto v=b-a;const auto len=v.lengthSqrd();if(len<1e-12)return (p-a).length();const auto t=std::max(0.0,std::min(1.0,(p-a).dotProduct(v)/len));return (p-(a+v*t)).length();}
AxisInk displayInk(const DrawnAxis& axis){auto ink=axis.expected;for(auto& c:ink.circles)c.centre+=axis.displayOffset;for(auto& line:ink.lines){line.first+=axis.displayOffset;line.second+=axis.displayOffset;}for(std::size_t i=1;i<axis.jogWorld.size();++i)ink.lines.push_back({axis.jogWorld[i-1],axis.jogWorld[i]});return ink;}
void layoutAxisEnds(AcDbDatabase& db,DrawnAnnotations& drawn,double midX,double midY){
 double diameter=0;for(auto& a:drawn.axes){a.expected=axisInk(a.id,a.vertical);for(const auto& c:a.expected.circles)diameter=std::max(diameter,c.radius*2);}
