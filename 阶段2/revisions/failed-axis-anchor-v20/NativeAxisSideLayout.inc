// Native TCH contents remain intact; single-ended display uses an explicit native clip container.
template<class T>std::unique_ptr<T,Close<T>> editObject(AcDbObjectId id){T* raw{};status(acdbOpenObject(raw,id,AcDb::kForWrite),"open native layout object for write");return std::unique_ptr<T,Close<T>>(raw);}
void axisInkLeaves(const AcDbEntity& e,AxisInk& ink,int depth=0){
 require(depth<=4,"axis ink nesting limit");if(const auto* c=AcDbCircle::cast(&e)){ink.circles.push_back({c->center(),c->radius()});return;}if(const auto* l=AcDbLine::cast(&e)){ink.lines.push_back({l->startPoint(),l->endPoint()});return;}if(AcDbText::cast(&e))return;
 require(std::wstring(e.isA()->name())==L"TDbAxisLabelSet"||std::wstring(e.isA()->name())==L"TDbSymbDrawingIndex","axis ink child class unexpected");TemplateParts children(&e);status(e.explode(children.values),"axis public ink explode");std::set<const void*> seen;for(int i=0;i<children.values.length();++i){require(children.values[i]&&seen.insert(children.values[i]).second,"axis ink duplicate/empty child");auto* child=AcDbEntity::cast(static_cast<AcRxObject*>(children.values[i]));require(child&&child!=&e&&child->database()==nullptr&&child->ownerId().isNull()&&child->objectId().isNull(),"axis ink child ownership");axisInkLeaves(*child,ink,depth+1);}
}
AxisInk axisInk(AcDbObjectId id,bool vertical){AxisInk result;auto e=open<AcDbEntity>(id);require(!e->isAProxy(),"axis ink proxy");axisInkLeaves(*e,result);require(result.circles.size()==2,"axis ink must contain two native source circles");std::sort(result.circles.begin(),result.circles.end(),[&](const AxisCircle& a,const AxisCircle& b){return vertical?a.centre.y<b.centre.y:a.centre.x<b.centre.x;});return result;}
