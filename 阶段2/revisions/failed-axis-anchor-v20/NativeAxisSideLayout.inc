 for(const bool vertical:{true,false})for(const bool low:{true,false}){std::vector<std::size_t> indices;std::vector<double> positions;for(std::size_t i=0;i<drawn.axes.size();++i){const auto& a=drawn.axes[i];if(a.vertical==vertical&&(low?a.negative:a.positive)){indices.push_back(i);positions.push_back(a.coordinate);}}const auto lanes=bcp::axisLabelLanes(positions,diameter);for(std::size_t i=0;i<indices.size();++i){auto& a=drawn.axes[indices[i]];const int lane=lanes[i];(low?a.lowLane:a.highLane)=lane;if(lane){const double out=(low?-1:1)*diameter*lane,along=diameter*lane;require(a.negative!=a.positive,"two-ended overlapping axis requires independent end containers");a.displayOffset=vertical?AcGeVector3d(along,out,0):AcGeVector3d(out,along,0);}}}
 for(auto& a:drawn.axes){a.expected=axisInk(a.id,a.vertical);if(!a.negative&&!a.positive){auto e=editObject<AcDbEntity>(a.id);status(e->setVisibility(AcDb::kInvisible),"hide both superseded axis ends");}if(a.negative!=a.positive)clipAxis(db,a,a.vertical?midY:midX);}status(db.setXclipFrame(0),"hide clipping frames in output database");
 for(std::size_t i=0;i<drawn.axes.size();++i)for(int side=0;side<2;++side){const auto& a=drawn.axes[i];if(!(side==0?a.negative:a.positive))continue;const auto scene=displayInk(a);const auto& c=scene.circles[side];for(std::size_t j=0;j<drawn.axes.size();++j){if(j==i)continue;const auto& b=drawn.axes[j];for(const auto& line:displayInk(b).lines){const double average=b.vertical?(line.first.y+line.second.y)/2:(line.first.x+line.second.x)/2;const bool low=average<(b.vertical?midY:midX);if(!(low?b.negative:b.positive))continue;require(pointSegmentDistance(c.centre,line.first,line.second)>=c.radius-1e-6,"another visible axis tail crosses an axis circle");}}}
