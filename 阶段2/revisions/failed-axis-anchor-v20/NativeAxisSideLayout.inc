 auto block=std::make_unique<AcDbBlockTableRecord>();const std::wstring name=L"BCP_AXIS_"+std::wstring(axis.vertical?L"V_":L"H_")+std::wstring(axis.label.begin(),axis.label.end());status(block->setName(name.c_str()),"axis container name");AcDbObjectId blockId;{auto table=editObject<AcDbBlockTable>(db.blockTableId());require(!table->has(name.c_str()),"axis container already exists");status(table->add(blockId,block.get()),"add native axis container definition");}block.release()->close();{auto owner=editObject<AcDbBlockTableRecord>(blockId);AcDbObjectIdArray one;one.append(axis.id);status(owner->assumeOwnershipOf(one),"move native TCH axis into clip container");}
