DrawnAnnotations drawAnnotations(AcDbDatabase& target,const bcp::Plan& plan,const bcp::Result& result,const std::wstring& config){
 const bool spacingTrial=GetPrivateProfileIntW(L"stage2",L"perimeterSpacingTrial",0,config.c_str())==1;const bool confirmedGap=GetPrivateProfileIntW(L"stage2",L"confirmedDimensionGap",0,config.c_str())==1;DrawnAnnotations drawn;require(result.dimensionMeasurementsComplete,"unresolved measurement source inhibits drawing");require(result.topology.outerBodyContours.size()==1,"one verified body contour required for sample drawing");const fs::path bankPath=ini(config,L"axisBank"),indexPath=ini(config,L"axisIndex"),referencePath=ini(config,L"reference");require(sha(bankPath)==ascii(ini(config,L"axisBankHash"))&&sha(indexPath)==ascii(ini(config,L"axisIndexHash"))&&sha(referencePath)==ascii(ini(config,L"referenceHash")),"annotation resource identity differs");
 std::ifstream index(indexPath);std::string tag,hash,line;index>>tag>>hash;require(index&&tag=="S2AXISTEMPLATES1"&&hash==sha(bankPath),"axis material index identity");double xmin{},ymin{},xmax{},ymax{};index>>tag>>xmin>>ymin>>xmax>>ymax;require(index&&tag=="B","axis material bounds absent");std::vector<AxisMaterial> materials;std::string direction,label,handle;while(index>>direction>>label>>handle){require(direction=="V"||direction=="H","axis material direction");materials.push_back({direction=="V",label,handle});}
 for(const auto point:result.topology.outerBodyContours[0])require(point.x>=xmin-1e-6&&point.x<=xmax+1e-6&&point.y>=ymin-1e-6&&point.y<=ymax+1e-6,"axis material sample bounds do not match building");
 AcDbDatabase bank(false,true),reference(false,true);status(bank.readDwgFile(bankPath.c_str(),AcDbDatabase::kForReadAndAllShare,false),"read native axis library");status(bank.closeInput(true),"finish axis library read");status(reference.readDwgFile(referencePath.c_str(),AcDbDatabase::kForReadAndAllShare,false),"read dimension reference");status(reference.closeInput(true),"finish reference read");ensureAxisLayer(reference,target);Working current(&target);if(confirmedGap){auto layers=open<AcDbLayerTable>(target.layerTableId());for(const auto name:{L"A-PUB_TITLE",L"A-PUB_TAB"}){AcDbObjectId id;status(layers->getAt(name,id),"legacy frame/table layer");auto record=editObject<AcDbLayerTableRecord>(id);record->setIsOff(true);require(record->isOff(),"legacy frame/table layer remains visible");drawn.legacyFrameLayers.push_back(id);}}
 // Convert only the eight source dimension annotations; retain their objects for audit.
 {auto model=open<AcDbBlockTableRecord>(modelId(target));AcDbBlockTableRecordIterator* raw{};status(model->newIterator(raw),"source dimension iterator");std::unique_ptr<AcDbBlockTableRecordIterator> it(raw);for(;!it->done();it->step()){AcDbObjectId id;status(it->getEntityId(id),"source annotation id");auto e=open<AcDbEntity>(id);if(std::wstring(e->isA()->name())==L"TDbDimension2")drawn.suppressed.push_back(id);}}
 require(drawn.suppressed.size()==8,"source dimension conversion cohort differs");for(const auto id:drawn.suppressed){AcDbEntity* raw{};status(acdbOpenObject(raw,id,AcDb::kForWrite),"source annotation writable");std::unique_ptr<AcDbEntity,Close<AcDbEntity>> e(raw);status(e->setVisibility(AcDb::kInvisible),"hide superseded source dimension");require(e->visibility()==AcDb::kInvisible,"source dimension remains visible");}
 for(const auto& axis:result.axes){if(!axis.confirmed||axis.confirmedLabel.empty())continue;const auto it=std::find_if(materials.begin(),materials.end(),[&](const AxisMaterial& m){return m.vertical==axis.vertical&&m.label==axis.confirmedLabel;});require(it!=materials.end(),"required numbered axis material unavailable");const auto source=find(bank,it->handle);{Working sourceWork(&bank);validateAxisCaption(source,it->label);}const auto id=cloneOne(bank,source,target);auto root=open<AcDbEntity>(id);AcGePoint3dArray grips;AcDbIntArray modes,geometry;status(root->getGripPoints(grips,modes,geometry),"axis cloned coordinates");require(grips.length()==8,"axis material shape changed");const double old=axis.vertical?grips[0].x:grips[0].y;root.reset();AcDbEntity* raw{};status(acdbOpenObject(raw,id,AcDb::kForWrite),"axis writable target");std::unique_ptr<AcDbEntity,Close<AcDbEntity>> edit(raw);status(edit->transformBy(AcGeMatrix3d::translation(axis.vertical?AcGeVector3d(axis.coordinate-old,0,0):AcGeVector3d(0,axis.coordinate-old,0))),"place numbered axis from actual station");status(edit->setLayer(L"AXIS"),"axis reference layer");edit.reset();validateAxisCaption(id,axis.confirmedLabel);require(axis.sides.resolved&&(axis.sides.negative||axis.sides.positive),"axis side visibility unresolved");DrawnAxis entry{id,axis.vertical,axis.coordinate,axis.confirmedLabel};entry.negative=axis.sides.negative;entry.positive=axis.sides.positive;entry.sourceNegative=entry.negative;entry.sourcePositive=entry.positive;entry.negativeReach=axis.negativeReach;entry.positiveReach=axis.positiveReach;if(spacingTrial)trialPositionAxis(id,axis.vertical,axis.vertical?ymin:xmin,axis.vertical?ymax:xmax,confirmedGap?3600:2600);drawn.axes.push_back(entry);}
 double bodyMinX=1e100,bodyMinY=1e100,bodyMaxX=-1e100,bodyMaxY=-1e100;for(const auto p:result.topology.outerBodyContours[0]){bodyMinX=std::min(bodyMinX,p.x);bodyMaxX=std::max(bodyMaxX,p.x);bodyMinY=std::min(bodyMinY,p.y);bodyMaxY=std::max(bodyMaxY,p.y);}layoutAxisEnds(target,drawn,(bodyMinX+bodyMaxX)/2,(bodyMinY+bodyMaxY)/2,confirmedGap,bodyMinX,bodyMinY,bodyMaxX,bodyMaxY);
 const auto templateId=find(reference,"19A0");AcGePoint3dArray templateGrips;{auto root=open<AcDbEntity>(templateId);AcDbIntArray modes,geometry;status(root->getGripPoints(templateGrips,modes,geometry),"reference single-dimension grips");require(templateGrips.length()==8,"single dimension template changed");}
 const double referenceOffset=spacingTrial?(confirmedGap?2800:1800):std::abs(templateGrips[2].y-templateGrips[0].y);require(referenceOffset>0,"reference dimension offset invalid");std::vector<double> bottom,top,left,right;for(const auto& a:drawn.axes){if(a.vertical){if(a.negative)bottom.push_back(a.coordinate);if(a.positive)top.push_back(a.coordinate);}else{if(a.negative)left.push_back(a.coordinate);if(a.positive)right.push_back(a.coordinate);}}
 const auto addDimension=[&](AcGePoint3d a,AcGePoint3d b,bool vertical,double baseline,const char* side,const char* row="axis"){const auto id=cloneOne(reference,templateId,target);if(vertical){AcDbEntity* raw{};status(acdbOpenObject(raw,id,AcDb::kForWrite),"vertical dimension writable");std::unique_ptr<AcDbEntity,Close<AcDbEntity>> e(raw);status(e->transformBy(AcGeMatrix3d::rotation(1.5707963267948966,AcGeVector3d::kZAxis,AcGePoint3d::kOrigin)),"rotate native dimension material");}moveDimensionGrip(id,2,a);moveDimensionGrip(id,3,b);AcGePoint3dArray points;{auto root=open<AcDbEntity>(id);AcDbIntArray modes,geometry;status(root->getGripPoints(points,modes,geometry),"dimension line actual point");}auto linePoint=points[0];if(vertical)linePoint.x=baseline;else linePoint.y=baseline;moveDimensionGrip(id,0,linePoint);const auto expected=(b-a).length();require(std::abs(nativeDimensionMeasurement(id)-expected)<=1e-6,"dimension displayed value does not match actual axis interval");DrawnDimension dimension{id,expected,side,vertical?a.y:a.x,vertical?b.y:b.x,row};if(confirmedGap)clipDimensionGap(target,dimension,side,vertical?a.x:a.y);drawn.dimensions.push_back(dimension);};
 for(const auto interval:bcp::axisIntervals(bottom))addDimension({interval.first,ymin,0},{interval.second,ymin,0},false,ymin-referenceOffset,"bottom");for(const auto interval:bcp::axisIntervals(top))addDimension({interval.first,ymax,0},{interval.second,ymax,0},false,ymax+referenceOffset,"top");for(const auto interval:bcp::axisIntervals(left))addDimension({xmin,interval.first,0},{xmin,interval.second,0},true,xmin-referenceOffset,"left");for(const auto interval:bcp::axisIntervals(right))addDimension({xmax,interval.first,0},{xmax,interval.second,0},true,xmax+referenceOffset,"right");

 if(spacingTrial){
  addDimension({xmin,ymin,0},{xmax,ymin,0},false,ymin-(confirmedGap?3600:2600),"bottom","total-body-envelope");
  addDimension({xmin,ymax,0},{xmax,ymax,0},false,ymax+(confirmedGap?3600:2600),"top","total-body-envelope");
  addDimension({xmin,ymin,0},{xmin,ymax,0},true,xmin-(confirmedGap?3600:2600),"left","total-body-envelope");
  addDimension({xmax,ymin,0},{xmax,ymax,0},true,xmax+(confirmedGap?3600:2600),"right","total-body-envelope");
  trialGuide(target,drawn,{xmin,ymin-(confirmedGap?2000:1000),0},{xmax,ymin-(confirmedGap?2000:1000),0});trialGuide(target,drawn,{xmin,ymax+(confirmedGap?2000:1000),0},{xmax,ymax+(confirmedGap?2000:1000),0});trialGuide(target,drawn,{xmin-(confirmedGap?2000:1000),ymin,0},{xmin-(confirmedGap?2000:1000),ymax,0});trialGuide(target,drawn,{xmax+(confirmedGap?2000:1000),ymin,0},{xmax+(confirmedGap?2000:1000),ymax,0});
 }

 std::ostringstream report;report<<std::setprecision(17)<<"{\"contract\":\"bcp.stage2.native-annotations.v1\",\"nativeAxisSets\":"<<drawn.axes.size()<<",\"nativeAxisIntervalDimensions\":"<<(drawn.dimensions.size()-(spacingTrial?4:0))<<",\"nativeTotalDimensions\":"<<(spacingTrial?4:0)<<",\"trialGuides\":"<<drawn.guides.size()<<",\"spacingTrial\":"<<(spacingTrial?"true":"false")<<",\"confirmedDimensionGap\":"<<(confirmedGap?"true":"false")<<",\"dimensionSampling\":\"retained-axis-per-side\",\"existingDimensionsRetained\":8,\"existingDimensionsHidden\":8,\"numberPolicy\":\"select matching prebuilt native number template;no business number setter\",\"threeRowsComplete\":false,\"styleStandardsComplete\":false,\"collisionLayoutComplete\":false,\"referenceTemplateOffsetModelMm\":"<<referenceOffset<<",\"sourceArchitectureErased\":false,\"error\":null}";auto text=report.str();text.pop_back();std::ostringstream details;details<<std::setprecision(17)<<text<<",\"axes\":[";for(std::size_t i=0;i<drawn.axes.size();++i){if(i)details<<',';const auto& a=drawn.axes[i];wchar_t h[32]{};a.id.handle().getIntoAsciiBuffer(h);const std::wstring wide=h;details<<"{\"handle\":\""<<std::string(wide.begin(),wide.end())<<"\",\"label\":\""<<a.label<<"\",\"vertical\":"<<(a.vertical?"true":"false")<<",\"station\":"<<a.coordinate<<",\"showNegative\":"<<(a.negative?"true":"false")<<",\"showPositive\":"<<(a.positive?"true":"false")<<",\"negativeWallReach\":"<<a.negativeReach<<",\"positiveWallReach\":"<<a.positiveReach<<",\"hiddenNegativeByOuterPriority\":"<<(a.sourceNegative&&!a.negative?"true":"false")<<",\"hiddenPositiveByOuterPriority\":"<<(a.sourcePositive&&!a.positive?"true":"false")<<",\"negativeLane\":"<<a.lowLane<<",\"positiveLane\":"<<a.highLane<<",\"displayOffset\":["<<a.displayOffset.x<<','<<a.displayOffset.y<<','<<a.displayOffset.z<<']'<<",\"nativeNestedInClipBlock\":"<<(!a.container.isNull()?"true":"false")<<",\"clipInverted\":"<<(a.clipInverted?"true":"false")<<",\"clipMin\":["<<a.clip.minPoint().x<<','<<a.clip.minPoint().y<<"],\"clipMax\":["<<a.clip.maxPoint().x<<','<<a.clip.maxPoint().y<<"],\"circles\":[";for(int c=0;c<2;++c){if(c)details<<',';const auto& circle=a.expected.circles[c];details<<"{\"centre\":["<<circle.centre.x<<','<<circle.centre.y<<','<<circle.centre.z<<"],\"radius\":"<<circle.radius<<'}';}details<<"]}";}details<<"],\"dimensions\":[";for(std::size_t i=0;i<drawn.dimensions.size();++i){if(i)details<<',';const auto& d=drawn.dimensions[i];wchar_t h[32]{};d.id.handle().getIntoAsciiBuffer(h);const std::wstring wide=h;details<<"{\"handle\":\""<<std::string(wide.begin(),wide.end())<<"\",\"expected\":"<<d.expected<<",\"row\":\""<<d.row<<"\",\"nativeNestedInGapBlock\":"<<(!d.container.isNull()?"true":"false")<<",\"gapClipMin\":["<<d.clip.minPoint().x<<','<<d.clip.minPoint().y<<"],\"gapClipMax\":["<<d.clip.maxPoint().x<<','<<d.clip.maxPoint().y<<"],\"side\":\""<<d.side<<"\",\"axisFrom\":"<<d.axisFrom<<",\"axisTo\":"<<d.axisTo<<",\"liveMeasurement\":"<<nativeDimensionMeasurement(d.id)<<'}';}details<<"]}";drawn.report=details.str();return drawn;
}
void verifyDrawnAnnotations(AcDbDatabase& db,const DrawnAnnotations& drawn){Working work(&db);for(const auto layer:drawn.legacyFrameLayers){AcDbObjectId id;status(db.getAcDbObjectId(id,false,layer.handle()),"saved legacy frame layer");auto record=open<AcDbLayerTableRecord>(id);require(record->isOff(),"saved legacy frame layer on");}for(const auto& guide:drawn.guides){AcDbObjectId id;status(db.getAcDbObjectId(id,false,guide.id.handle()),"saved trial guide");auto e=open<AcDbLine>(id);require((e->startPoint()-guide.a).length()<1e-6&&(e->endPoint()-guide.b).length()<1e-6&&e->colorIndex()==8,"saved trial guide differs");}for(const auto original:drawn.suppressed){AcDbObjectId saved;status(db.getAcDbObjectId(saved,false,original.handle()),"saved source dimension id");auto e=open<AcDbEntity>(saved);require(std::wstring(e->isA()->name())==L"TDbDimension2"&&e->visibility()==AcDb::kInvisible,"superseded source dimension visibility/type differs");}for(const auto& axis:drawn.axes){AcDbHandle handle;handle=axis.id.handle();AcDbObjectId id;status(db.getAcDbObjectId(id,false,handle),"saved axis handle");validateAxisCaption(id,axis.label);verifyAxisContainer(db,axis);const auto ink=axisInk(id,axis.vertical);for(int i=0;i<2;++i)require((ink.circles[i].centre-axis.expected.circles[i].centre).length()<1e-6&&std::abs(ink.circles[i].radius-axis.expected.circles[i].radius)<1e-6,"saved native axis display differs");auto root=open<AcDbEntity>(id);AcGePoint3dArray points;AcDbIntArray modes,geometry;status(root->getGripPoints(points,modes,geometry),"saved axis points");require(points.length()==8&&std::abs((axis.vertical?points[0].x:points[0].y)-axis.coordinate)<=1e-6,"saved axis station differs");}for(const auto& dimension:drawn.dimensions){verifyDimensionGap(db,dimension);AcDbHandle handle;handle=dimension.id.handle();AcDbObjectId id;status(db.getAcDbObjectId(id,false,handle),"saved dimension handle");require(std::abs(nativeDimensionMeasurement(id)-dimension.expected)<=1e-6,"saved dimension actual value differs");}}
