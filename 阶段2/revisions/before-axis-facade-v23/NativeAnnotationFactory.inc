// Native template-based drawing. Existing architectural objects are never erased.
struct TemplateParts {
 AcDbVoidPtrArray values;const AcDbEntity* root;bool safe=true;
 explicit TemplateParts(const AcDbEntity* source):root(source){}
 ~TemplateParts(){nativeparts::forEachDistinct(values,[&](void* raw){auto* e=AcDbEntity::cast(static_cast<AcRxObject*>(raw));if(e&&e!=root&&e->objectId().isNull()&&e->ownerId().isNull()&&e->database()==nullptr)delete e;});}
};
struct AxisMaterial {bool vertical;std::string label,handle;};
struct AxisCircle {AcGePoint3d centre;double radius;};
struct AxisInk {std::vector<AxisCircle> circles;std::vector<std::pair<AcGePoint3d,AcGePoint3d>> lines;};
struct DrawnAxis {AcDbObjectId id;bool vertical;double coordinate;std::string label;bool negative=true,positive=true;int lowLane=0,highLane=0;double negativeReach=0,positiveReach=0;bool sourceNegative=true,sourcePositive=true;AcDbObjectId container,filter,connector;AcDbExtents clip;bool clipInverted=false;AcGeVector3d displayOffset{0,0,0};std::vector<AcGePoint3d> jogWorld;AxisInk expected;};
struct DrawnDimension {AcDbObjectId id;double expected;std::string side;double axisFrom=0,axisTo=0;std::string row="axis";AcDbObjectId container,filter;AcDbExtents clip;};
struct TrialGuide {AcDbObjectId id;AcGePoint3d a,b;};
struct DrawnAnnotations {std::vector<TrialGuide> guides;std::vector<AcDbObjectId> legacyFrameLayers;std::vector<DrawnAxis> axes;std::vector<DrawnDimension> dimensions;std::vector<AcDbObjectId> suppressed;std::string report;};
void readAxisLeaves(const AcDbEntity& source,const std::string& number,int depth,int& texts,int& circles){
 require(depth<=4,"axis material nesting limit");if(const auto* text=AcDbText::cast(&source)){AcString value;status(text->textString(value),"axis public text");require(std::wstring(value.kACharPtr())==std::wstring(number.begin(),number.end()),"axis number mismatch");++texts;return;}if(AcDbCircle::cast(&source)){++circles;return;}if(AcDbLine::cast(&source))return;
 const std::wstring type=source.isA()->name();require(type==L"TDbAxisLabelSet"||type==L"TDbSymbDrawingIndex","unexpected axis material child type");TemplateParts parts(&source);status(source.explode(parts.values),"axis public nested display read");std::set<const AcDbEntity*> seen;for(int i=0;i<parts.values.length();++i){auto* e=AcDbEntity::cast(static_cast<AcRxObject*>(parts.values[i]));require(e&&e!=&source&&e->objectId().isNull()&&e->ownerId().isNull()&&e->database()==nullptr,"axis explode ownership uncertain");require(seen.insert(e).second,"duplicate axis child pointer");readAxisLeaves(*e,number,depth+1,texts,circles);}
}
void validateAxisCaption(AcDbObjectId id,const std::string& number){auto root=open<AcDbEntity>(id);require(std::wstring(root->isA()->name())==L"TDbAxisLabelSet","axis native type differs");int texts=0,circles=0;readAxisLeaves(*root,number,0,texts,circles);require(texts==2&&circles==2,"axis material is not one two-sided numbered station");}

AcDbObjectId cloneOne(AcDbDatabase& source,AcDbObjectId id,AcDbDatabase& target){AcDbObjectIdArray one;one.append(id);AcDbIdMapping map;status(source.wblockCloneObjects(one,modelId(target),map,AcDb::kDrcIgnore,false),"clone native annotation material");AcDbIdPair pair;pair.setKey(id);require(map.compute(pair)&&pair.isCloned()&&!pair.value().isNull(),"native annotation clone map");return pair.value();}
void moveDimensionGrip(AcDbObjectId id,int index,const AcGePoint3d& destination){auto root=open<AcDbEntity>(id);AcGePoint3dArray points;AcDbIntArray modes,geometry;status(root->getGripPoints(points,modes,geometry),"dimension actual grips");require(index>=0&&index<points.length(),"dimension grip index absent");const auto offset=destination-points[index];root.reset();AcDbEntity* raw{};status(acdbOpenObject(raw,id,AcDb::kForWrite),"dimension writable target");std::unique_ptr<AcDbEntity,Close<AcDbEntity>> edit(raw);AcDbIntArray selected;selected.append(index);status(edit->moveGripPointsAt(selected,offset),"dimension public grip movement");}
double nativeDimensionMeasurement(AcDbObjectId id){auto root=open<AcDbEntity>(id);require(std::wstring(root->isA()->name())==L"TDbDimension2","dimension native type differs");TemplateParts parts(root.get());status(root->explode(parts.values),"dimension public display read");require(parts.values.length()==1,"single dimension material contains unexpected segments");auto* d=AcDbAlignedDimension::cast(static_cast<AcRxObject*>(parts.values[0]));require(d&&d!=root.get()&&d->objectId().isNull()&&d->ownerId().isNull()&&d->database()==nullptr,"native dimension readback ownership/type");double value{};status(d->measurement(value),"native displayed dimension measurement");return value;}
void ensureAxisLayer(AcDbDatabase& reference,AcDbDatabase& target){auto table=open<AcDbLayerTable>(reference.layerTableId());AcDbObjectId layer;status(table->getAt(L"AXIS",layer),"reference AXIS layer");AcDbObjectIdArray one;one.append(layer);AcDbIdMapping map;status(reference.wblockCloneObjects(one,target.layerTableId(),map,AcDb::kDrcIgnore,false),"import named reference layer");}
