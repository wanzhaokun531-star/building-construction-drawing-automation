        else{points.append(AcGePoint3d(m.leftWall,station,0));points.append(AcGePoint3d(m.leftDimension-m.leftGap,station,0));points.append(AcGePoint3d(m.rightWall,station,0));points.append(AcGePoint3d(m.rightDimension+m.rightGap,station,0));}
    }return points;
}
AcGePoint3dArray fourSideExpectedGrips(const FourSideMetrics& m,bool vertical,const std::vector<double>& stations){
    // Six geometric controls per station. The two collection UI controls are
