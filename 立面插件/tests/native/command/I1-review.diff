+BOOL APIENTRY DllMain(HMODULE instance, DWORD reason, LPVOID) {
+  if (reason == DLL_PROCESS_ATTACH) {
+    moduleHandle = instance;
+    DisableThreadLibraryCalls(instance);
+  }
+  return TRUE;
