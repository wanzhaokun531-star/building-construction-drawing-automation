+                inkPixels=int(xx.size), outsidePixels=int(bad_x.size), maxOutsidePixel=float(distances.max()),
+                candidatePixelCorners=polygon.tolist(), pixelCell='[x,x+1] by [y,y+1]; y down; top-left phase 0',
