+bool samePoint(Point2 a,Point2 b) {
+    const double scale=(std::max)({1.0,std::abs(a.x),std::abs(a.y),std::abs(b.x),std::abs(b.y)});
+    return norm({a.x-b.x,a.y-b.y}) <= std::numeric_limits<double>::epsilon()*scale*64;
