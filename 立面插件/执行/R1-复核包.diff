+void levelConflictRequiresConfirmation() {
+    auto s=emptyScene(); group(s,"A1","A2","A3",0,0);
+    s.primitives.push_back(title("A4",{5,5},"二层平面图 +3900 mm"));
+    s.levelAssociations.push_back({key("A2"),key("A3"),key("A4"),{0,0},{0,3000},{0,1},1});
