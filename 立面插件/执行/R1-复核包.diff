+std::optional<double> levelMm(const Primitive2& p) {
+    if (!isLevelLabel(p)) { return std::nullopt; }
+    static const std::regex declaration("([+-]?[0-9]+(?:\\.[0-9]+)?)\\s*(mm|m)(?:\\s|$)");
