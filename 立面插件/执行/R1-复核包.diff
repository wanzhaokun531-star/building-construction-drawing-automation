+void axisProjectionReversesOrder() {
+    PlanSnapshot p; p.databaseIdentity="matching-plan"; p.confirmedMmPerInputUnit=1;
+    p.axes={{key("1"),"1",{0,0}},{key("2"),"2",{3000,0}},{key("3"),"3",{7000,0}},{key("4"),"4",{10000,0}}};
